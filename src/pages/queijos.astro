                    <div class="space-y-4 sm:space-y-5">
                      <span class="font-script text-[clamp(1.05rem,4.2vw,1.55rem)] sm:text-[clamp(1.15rem,2.4vw,1.6rem)] lg:text-[clamp(1.1rem,1.55vw,1.5rem)] whitespace-nowrap leading-normal text-[#ffffff] block">
                        {cat.scriptSubtitle}
                      </span>
                      <h3 class="font-sans text-2xl sm:text-3xl lg:text-4xl font-black uppercase tracking-tight leading-[1.22] text-[#ffffff]">
                        {cat.name}
                      </h3>
                    </div>
                    <p class="text-sm sm:text-base text-[#ffffff] leading-relaxed">
                      {cat.description}
                    </p>
                    <p class="text-sm sm:text-base text-[#ffffff] leading-snug font-black">
                      {cat.milkOrigin}.
                    </p>
                  </div>

                  {cat.products.map((product, idx) => (
                    <>
                      <article
                        class="rounded-[26px] border-2 border-[#169f38] bg-[#ffffff] text-[#000000] overflow-hidden flex flex-col justify-between h-full transition-transform duration-100 hover:-translate-y-1"
                      >
                        <div>
                          <div class="relative aspect-[4/3] bg-[#ffffff] border-b-2 border-[#169f38] p-5 flex items-center justify-center">
                            <img
                              src={product.image}
                              alt={product.name}
                              class="max-h-full max-w-full object-contain"
                              loading="lazy"
                            />
                            {product.badge && (
                              <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-[#169f38] text-[#ffffff] border border-[#169f38] text-[11px] font-black uppercase">
                                {product.badge}
                              </span>
                            )}
                          </div>
                          <div class="p-6 space-y-3">
                            <div class="flex items-center justify-between text-[11px] font-black uppercase text-[#169f38]">
                              <span>{product.format}</span>
                              <span>Leite de {product.milkType}</span>
                            </div>
                            <h4 class="font-sans text-lg font-black uppercase leading-[1.3] text-[#169f38] pt-0.5">
                              {product.name}
                            </h4>
                            <p class="text-xs leading-relaxed text-[#000000]">
                              {product.description}
                            </p>
                          </div>
                        </div>
                        <div class="px-6 pb-6">
                          <Button
                            href={cat.ctaLink}
                            variant="secondary"
                            size="sm"
                            icon={cat.ctaIcon}
                            label={cat.ctaText}
                            class="w-full"
                          />
                        </div>
                      </article>

                      {/* CARD INFORMATIVO 2: Textura & Carácter — Espalhado na linha intermédia */}
                      {idx === card2AfterIdx && (
                        <div class="rounded-tl-[64px] sm:rounded-tl-[76px] rounded-tr-[26px] rounded-br-[26px] rounded-bl-[26px] border-2 border-[#169f38] bg-[#169f38] text-[#ffffff] p-8 sm:p-9 flex flex-col justify-between gap-6 h-full">
                          <div class="space-y-4 sm:space-y-5">
                            <span class="font-script text-[clamp(1.05rem,4.2vw,1.55rem)] sm:text-[clamp(1.15rem,2.4vw,1.6rem)] lg:text-[clamp(1.1rem,1.55vw,1.5rem)] whitespace-nowrap leading-normal text-[#ffffff] block">
                              Arte & Sabedoria Queijeira
                            </span>
                            <h3 class="font-sans text-2xl sm:text-3xl lg:text-4xl font-black uppercase tracking-tight leading-[1.22] text-[#ffffff]">
                              Textura & Carácter
                            </h3>
                          </div>
                          <p class="text-sm sm:text-base text-[#ffffff] leading-relaxed">
                            {cat.textureNotes}. {cat.sensoryDetails}
                          </p>
                          <p class="text-sm sm:text-base text-[#ffffff] leading-snug font-black">
                            {cat.processDetail}.
                          </p>
                        </div>
                      )}

                      {/* CARD INFORMATIVO 3: Sugestão à Mesa — Espalhado na linha seguinte */}
                      {idx === card3AfterIdx && (
                        <div class="rounded-tl-[64px] sm:rounded-tl-[76px] rounded-tr-[26px] rounded-br-[26px] rounded-bl-[26px] border-2 border-[#169f38] bg-[#169f38] text-[#ffffff] p-8 sm:p-9 flex flex-col justify-between gap-6 h-full">
                          <div class="space-y-4 sm:space-y-5">
                            <span class="font-script text-[clamp(1.05rem,4.2vw,1.55rem)] sm:text-[clamp(1.15rem,2.4vw,1.6rem)] lg:text-[clamp(1.1rem,1.55vw,1.5rem)] whitespace-nowrap leading-normal text-[#ffffff] block">
                              Harmonização & Tradição à Mesa
                            </span>
                            <h3 class="font-sans text-2xl sm:text-3xl lg:text-4xl font-black uppercase tracking-tight leading-[1.22] text-[#ffffff]">
                              Sugestão à Mesa
                            </h3>
                          </div>
                          <p class="text-sm sm:text-base text-[#ffffff] leading-relaxed">
                            {cat.pairingSuggestion} {cat.servingDetails}
                          </p>
                          <p class="text-sm sm:text-base text-[#ffffff] leading-snug font-black">
                            {cat.pairingHighlight}.
                          </p>
                        </div>
                      )}
                    </>
                  ))}
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Remove any browser focus box / rectangle around SVG interactive zones */
  .cheese-board-zone,
  .cheese-board-zone:focus,
  .cheese-board-zone:focus-visible {
    outline: none !important;
  }

  /* 1. QUEIJOS CURADOS:
     Normal state: Fatia já está partida mas encostada junto ao queijo (translate(0, 0)).
     Hover state: A fatia anda para trás/fora para notar-se! */
  .zone-curados .curado-slice {
    transform: translate(0, 0);
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .zone-curados:hover .curado-slice {
    transform: translate(34px, 22px);
  }

  /* 2. QUEIJOS FRESCOS:
     Normal state: Queijo fresco está dentro da caixa/forma branca.
     Hover state: O queijo fresco que está lá dentro levanta para cima! */
  .zone-frescos .fresco-rising-cheese {
    transform: translateY(0);
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .zone-frescos .fresco-drop-shadow {
    transform-origin: 600px 233px;
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1), opacity 320ms ease;
  }

  .zone-frescos:hover .fresco-rising-cheese {
    transform: translateY(-42px);
  }

  .zone-frescos:hover .fresco-drop-shadow {
    transform: scale(0.88);
    opacity: 0.3;
  }

  /* 3. REQUEIJÃO:
     Normal state: Colher pousada junto ao requeijão.
     Hover state: A colher vem com um pouco de requeijão! */
  .zone-requeijao .requeijao-spoon-scoop {
    transform: translate(0, 0) rotate(0deg);
    transform-origin: 990px 200px;
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .zone-requeijao .spoon-requeijao-portion {
    opacity: 0;
    transform: scale(0.5) translateY(6px);
    transform-origin: 954px 214px;
    transition: opacity 220ms ease, transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .zone-requeijao:hover .requeijao-spoon-scoop {
    transform: translate(22px, -28px) rotate(-10deg);
  }

  .zone-requeijao:hover .spoon-requeijao-portion {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
</style>

<script>
  function initCheeseBoard() {
    const zones = document.querySelectorAll<SVGGElement>('[data-board-category]');
    const panels = document.querySelectorAll<HTMLElement>('[data-category-panel]');

    if (!zones.length || !panels.length) return;

    function activateCategory(categoryId: string) {
      // 1. Update SVG zones (badge colors & active state)
      zones.forEach((zone) => {
        const isMatch = zone.getAttribute('data-board-category') === categoryId;
        zone.setAttribute('data-active', isMatch ? 'true' : 'false');

        const badgeBg = zone.querySelector<SVGRectElement>('.badge-bg');
        const badgeSub = zone.querySelector<SVGTextElement>('.badge-sub');
        const badgeTitle = zone.querySelector<SVGTextElement>('.badge-title');

        if (isMatch) {
          badgeBg?.setAttribute('fill', '#169f38');
          badgeSub?.setAttribute('fill', '#ffffff');
          badgeTitle?.setAttribute('fill', '#ffffff');
        } else {
          badgeBg?.setAttribute('fill', '#ffffff');
          badgeSub?.setAttribute('fill', '#169f38');
          badgeTitle?.setAttribute('fill', '#000000');
        }
      });

      // 2. Show corresponding cheese cards below
      panels.forEach((panel) => {
        const isMatch = panel.getAttribute('data-category-panel') === categoryId;
        panel.classList.toggle('block', isMatch);
        panel.classList.toggle('hidden', !isMatch);
      });
    }

    zones.forEach((zone) => {
      const cat = zone.getAttribute('data-board-category');
      if (!cat) return;

      zone.addEventListener('mouseenter', () => activateCategory(cat));
      zone.addEventListener('click', () => activateCategory(cat));
      zone.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          activateCategory(cat);
        }
      });
    });

    // Support explicit URL hash (#frescos, #curados, #requeijao) if navigated directly or via header menu
    function checkHashAndActivate(shouldScroll = false) {
      const hash = window.location.hash.replace('#', '');
      if (hash === 'frescos' || hash === 'curados' || hash === 'requeijao') {
        activateCategory(hash);
        if (shouldScroll) {
          const stage = document.getElementById('categoria-cards-stage');
          stage?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    }

    checkHashAndActivate(false);
    window.addEventListener('hashchange', () => checkHashAndActivate(true));
  }

  initCheeseBoard();
  document.addEventListener('astro:after-swap', initCheeseBoard);
</script>
