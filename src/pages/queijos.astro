            // Position the 3 informative cards spread across the rows:
            // Card 1: before product 0 (Row 1, Col 1)
            // Card 2: after product 3 for 6-item categories (Row 2, Col 3), or after product 6 for 15-item categories (Row 3, Col 3)
            // Card 3: after product 4 for 6-item categories (Row 3, Col 2), or after product 11 for 15-item categories (Row 5, Col 2)
            const card2AfterIdx = cat.products.length > 6 ? 6 : 3;
            const card3AfterIdx = cat.products.length > 6 ? 11 : 4;

            return (
              <div
                data-category-panel={cat.id}
                class="hidden"
              >
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch">
                  {/* CARD INFORMATIVO 1: Até Leite 100% Nacional Selecionado (Vaca e Cabra) — Linha 1 */}
