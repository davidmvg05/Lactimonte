---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { PRODUCTS, CHEESE_CATEGORIES } from '../data/products';

const frescos = PRODUCTS.filter((p) => p.category === 'frescos');
const curados = PRODUCTS.filter((p) => p.category === 'curados');
const requeijoes = PRODUCTS.filter((p) => p.category === 'requeijao');

const categoriesWithProducts = [
  {
    ...CHEESE_CATEGORIES.find((c) => c.id === 'curados')!,
    products: curados,
    ctaText: 'Pedir Informação Comercial',
    ctaLink: '/contactos',
    ctaIcon: 'send' as const,
    sensoryDetails:
      'Ao corte revela uma estrutura equilibrada e olhos naturais discretos, resultado do volteio manual e do tempo de repouso nas nossas câmaras.',
    servingDetails:
      'Retire do frio 20 a 30 minutos antes de servir para libertar todos os aromas da maturação e a untuosidade natural da pasta. Harmoniza na perfeição com vinhos tintos encorpados ou brancos estruturados.',
    pairingHighlight: 'Ideal para Tábuas Saloias, Pão de Mafra, Frutos Secos & Vinhos Portugueses',
  },
  {
    ...CHEESE_CATEGORIES.find((c) => c.id === 'frescos')!,
    products: frescos,
    ctaText: 'Pedir Informação',
    ctaLink: '/contactos',
    ctaIcon: 'send' as const,
    sensoryDetails:
      'Cada queijo mantém a humidade natural do soro fresco e uma coalhada delicada que se desfaz suavemente no paladar, preservando a pureza do leite.',
    servingDetails:
      'Sirva bem fresco, acabado de desenformar, com um fio de azeite virgem extra e orégãos, ou acompanhe com mel multifloral, nozes e fruta da época para um momento leve e nutritivo.',
    pairingHighlight: 'Perfeito ao Pequeno-Almoço, Saladas Mediterrânicas & Lanches Saudáveis',
  },
  {
    ...CHEESE_CATEGORIES.find((c) => c.id === 'requeijao')!,
    products: requeijoes,
    ctaText: 'Ver Receitas com Requeijão',
    ctaLink: '/receitas',
    ctaIcon: 'book-open' as const,
    sensoryDetails:
      'A fervura lenta do soro doce cria flocos lácteos macios e cremosos, sem acidez, proporcionando uma experiência reconfortante e genuinamente artesanal.',
    servingDetails:
      'Desfrute simples, polvilhado com canela e mel a acompanhar um café acabado de fazer, barrado em tostas rústicas ou como ingrediente nobre em queijadas e tartes tradicionais.',
    pairingHighlight: 'Sublime ao Natural, com Doce Extra de Abóbora, Figo ou Frutos Vermelhos',
  },
];
---

<BaseLayout
  title="Os Nossos Queijos | Queijos Frescos, Curados e Requeijão Lactimonte"
  description="Catálogo completo da Queijaria Lactimonte: explore a nossa tábua de queijos interativa com Queijos Curados, Queijos Frescos e Requeijão."
>
  <!-- Interactive Hand-Drawn Cheese Board & Category Cards -->
  <section
    id="tabua-queijos"
    class="py-12 md:py-20 bg-[#ffffff] text-[#000000]"
    aria-labelledby="cheese-board-heading"
  >
    <div class="lacti-container">
      <!-- Section Header -->
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-16 md:mb-24">
        <div>
          <span class="font-script text-3xl md:text-4xl text-[#169f38] block mb-4 md:mb-5">
            A Arte Queijeira desde 1980
          </span>
          <h1
            id="cheese-board-heading"
            class="font-sans text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight leading-[1.2] text-[#000000]"
          >
            <span class="block">Três Especialidades.</span>
            <span class="block mt-1.5 sm:mt-2 text-[#169f38]">Uma Tradição Saloia.</span>
          </h1>
        </div>
        <p class="max-w-md text-base md:text-lg font-normal text-[#000000]">
          Passe o cursor ou selecione na tábua os <strong>Queijos Curados</strong>, <strong>Queijos Frescos</strong> ou <strong>Requeijão</strong> para revelar em baixo os cartões dessa categoria.
        </p>
      </div>

      <!-- Realistic Hand-Drawn SVG Cheese Board -->
      <div class="bg-[#ffffff] pt-6 md:pt-10 mb-8">
        <div class="relative w-full overflow-hidden">
          <svg
            viewBox="0 0 1240 590"
            class="w-full h-auto select-none"
            role="img"
            aria-label="Tábua de queijos realista desenhada à mão com Queijo Curado, Queijo Fresco e Requeijão Meio Gordo Lactimonte"
          >
            <defs>
              <!-- Realistic Warm Wood Gradients for the Board -->
              <linearGradient id="wood-top-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#e8be82" />
                <stop offset="40%" stop-color="#d79f59" />
                <stop offset="80%" stop-color="#c4863e" />
                <stop offset="100%" stop-color="#b3742e" />
              </linearGradient>
              <linearGradient id="wood-side-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#7a4612" />
                <stop offset="35%" stop-color="#9e5f20" />
                <stop offset="70%" stop-color="#854d16" />
                <stop offset="100%" stop-color="#63360b" />
              </linearGradient>

              <!-- Image 2 Inspiration: Golden Dimpled Queijo Curado Top & Paste + White Cinta -->
              <radialGradient id="curado-top-realistic" cx="45%" cy="40%" r="60%">
                <stop offset="0%" stop-color="#ffea8a" />
                <stop offset="55%" stop-color="#f7cb52" />
                <stop offset="88%" stop-color="#e5a929" />
                <stop offset="100%" stop-color="#cc8d18" />
              </radialGradient>
              <linearGradient id="curado-paste-realistic" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#fff6bd" />
                <stop offset="60%" stop-color="#f7dc74" />
                <stop offset="100%" stop-color="#e3be46" />
              </linearGradient>
              <linearGradient id="curado-cinta-white" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#e8e6df" />
                <stop offset="25%" stop-color="#ffffff" />
                <stop offset="65%" stop-color="#faf9f5" />
                <stop offset="100%" stop-color="#dedad0" />
              </linearGradient>

              <!-- Image 1 Inspiration: White Cup & Textured Curd Queijo Fresco -->
              <linearGradient id="fresco-cup-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#e6ebe8" />
                <stop offset="30%" stop-color="#ffffff" />
                <stop offset="75%" stop-color="#f7faf8" />
                <stop offset="100%" stop-color="#d8e0dc" />
              </linearGradient>
              <radialGradient id="fresco-curd-top" cx="50%" cy="45%" r="55%">
                <stop offset="0%" stop-color="#ffffff" />
                <stop offset="70%" stop-color="#f9fbf9" />
                <stop offset="100%" stop-color="#e8eee9" />
              </radialGradient>

              <!-- Image 3 Inspiration: Requeijão Meio Gordo Fluffy Mound & Tub + Orange Doce -->
              <radialGradient id="requeijao-mound-grad" cx="45%" cy="38%" r="60%">
                <stop offset="0%" stop-color="#ffffff" />
                <stop offset="55%" stop-color="#fdfbf2" />
                <stop offset="85%" stop-color="#f3ead2" />
                <stop offset="100%" stop-color="#e3d5b3" />
              </radialGradient>
              <linearGradient id="requeijao-tub-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#e3e6e4" />
                <stop offset="35%" stop-color="#ffffff" />
                <stop offset="75%" stop-color="#f5f7f6" />
                <stop offset="100%" stop-color="#cfd6d2" />
              </linearGradient>
              <linearGradient id="compota-orange-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ffc233" />
                <stop offset="55%" stop-color="#f29f05" />
                <stop offset="100%" stop-color="#c47100" />
              </linearGradient>

              <!-- Wood grain texture pattern -->
              <pattern id="sketch-wood-hatch" width="12" height="12" patternTransform="rotate(25 0 0)" patternUnits="userSpaceOnUse">
                <line x1="0" y1="0" x2="0" y2="12" stroke="#5c330a" stroke-width="1" stroke-opacity="0.18" />
              </pattern>
            </defs>

            <!-- ============================================================ -->
            <!-- 1. REALISTIC WOODEN CHEESE BOARD & SMALL ACCOMPANIMENTS      -->
            <!-- ============================================================ -->
            <g class="board-wood-base" pointer-events="none">
              <!-- Soft Board Drop Shadow on Table -->
              <ellipse cx="600" cy="372" rx="520" ry="188" fill="#000000" fill-opacity="0.12" />

              <!-- 3D Wooden Rim / Side Thickness -->
              <path
                d="M 95 348 C 92 432, 235 525, 585 532 C 920 538, 1065 458, 1088 372 L 1096 346 L 1185 350 C 1212 352, 1226 332, 1222 308 L 1218 282 L 98 320 Z"
                fill="url(#wood-side-grad)"
                stroke="#2b1704"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <!-- Hand-drawn vertical bark/wood grain strokes along the 3D edge -->
              <path
                d="M 135 388 L 135 415 M 175 410 L 175 440 M 220 432 L 220 462 M 275 452 L 275 482 M 335 468 L 335 498 M 405 480 L 405 512 M 480 488 L 480 520 M 555 494 L 555 526 M 635 494 L 635 526 M 715 490 L 715 520 M 790 482 L 790 512 M 865 468 L 865 496 M 935 450 L 935 478 M 995 425 L 995 452 M 1048 395 L 1048 420"
                stroke="#4a2808"
                stroke-width="2"
                stroke-linecap="round"
              />

              <!-- Main Colored Top Surface of the Wooden Paddle Board -->
              <path
                d="M 90 318 C 78 195, 225 112, 580 108 C 915 104, 1062 185, 1092 268 C 1118 270, 1165 266, 1195 268 C 1220 270, 1230 294, 1220 316 C 1210 335, 1180 338, 1094 334 C 1060 432, 905 498, 580 494 C 230 490, 105 415, 90 318 Z"
                fill="url(#wood-top-grad)"
                stroke="#2b1704"
                stroke-width="3.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M 90 318 C 78 195, 225 112, 580 108 C 915 104, 1062 185, 1092 268 C 1118 270, 1165 266, 1195 268 C 1220 270, 1230 294, 1220 316 C 1210 335, 1180 338, 1094 334 C 1060 432, 905 498, 580 494 C 230 490, 105 415, 90 318 Z"
                fill="url(#sketch-wood-hatch)"
              />

              <!-- Recessed Inner Juice Groove of the Cheese Board -->
              <path
                d="M 118 316 C 108 210, 248 132, 580 128 C 895 124, 1038 196, 1066 274 M 1064 330 C 1030 416, 882 474, 580 470 C 250 466, 130 398, 118 316"
                fill="none"
                stroke="#754210"
                stroke-width="2.2"
                stroke-dasharray="18 6 5 6"
                stroke-linecap="round"
              />

              <!-- Organic Wood Grain Lines & Knots -->
              <path
                d="M 155 245 C 310 220, 480 232, 660 224 C 820 218, 945 238, 1035 260"
                fill="none"
                stroke="#8c5319"
                stroke-width="1.5"
                stroke-opacity="0.5"
                stroke-linecap="round"
              />
              <path
                d="M 140 355 C 295 378, 465 362, 635 375 C 815 388, 940 365, 1045 342"
                fill="none"
                stroke="#8c5319"
                stroke-width="1.5"
                stroke-opacity="0.5"
                stroke-linecap="round"
              />
              <path
                d="M 240 420 C 390 438, 540 425, 710 432 C 745 434, 770 422, 748 415 C 728 408, 695 418, 718 426"
                fill="none"
                stroke="#5c330a"
                stroke-width="1.4"
                stroke-opacity="0.42"
                stroke-linecap="round"
              />

              <!-- Board Handle Hole & Rustic Twine Cord -->
              <ellipse
                cx="1168"
                cy="302"
                rx="16"
                ry="12"
                fill="#5c330a"
                stroke="#2b1704"
                stroke-width="2.5"
              />
              <path
                d="M 1180 296 C 1205 282, 1232 292, 1230 316 C 1228 338, 1198 330, 1178 308"
                fill="none"
                stroke="#754210"
                stroke-width="3.5"
                stroke-linecap="round"
              />

              <!-- ========================================================== -->
              <!-- SMALL NON-INTERACTIVE ACCOMPANIMENTS ON THE BOARD          -->
              <!-- ========================================================== -->

              <!-- A. Red/Purple Grapes Cluster (Top Left-Center) -->
              <g transform="translate(415, 148) scale(0.82)">
                <path d="M 35 12 C 42 -5, 58 -8, 68 2" fill="none" stroke="#3b5e18" stroke-width="2.8" stroke-linecap="round" />
                <path d="M 28 15 C 10 2, 2 18, 16 28 C 6 34, 18 46, 32 34 C 42 42, 52 28, 38 18 Z" fill="#4f9e34" stroke="#1f3b08" stroke-width="2" />
                <circle cx="45" cy="24" r="11" fill="#6b2346" stroke="#290817" stroke-width="2" />
                <circle cx="62" cy="28" r="11" fill="#822b56" stroke="#290817" stroke-width="2" />
                <circle cx="34" cy="36" r="11" fill="#822b56" stroke="#290817" stroke-width="2" />
                <circle cx="52" cy="40" r="12" fill="#9c3869" stroke="#290817" stroke-width="2" />
                <circle cx="70" cy="44" r="10.5" fill="#6b2346" stroke="#290817" stroke-width="2" />
                <circle cx="42" cy="54" r="11" fill="#6b2346" stroke="#290817" stroke-width="2" />
                <circle cx="59" cy="56" r="11" fill="#822b56" stroke="#290817" stroke-width="2" />
                <circle cx="50" cy="68" r="10" fill="#9c3869" stroke="#290817" stroke-width="2" />
                <circle cx="49" cy="36" r="2.5" fill="#ffffff" fill-opacity="0.7" />
                <circle cx="31" cy="33" r="2" fill="#ffffff" fill-opacity="0.7" />
                <circle cx="59" cy="25" r="2" fill="#ffffff" fill-opacity="0.7" />
              </g>

              <!-- B. Green Muscat Grapes Cluster (Top Right-Center) -->
              <g transform="translate(712, 145) scale(0.8)">
                <path d="M 40 8 C 35 -6, 20 -6, 12 4" fill="none" stroke="#4a3212" stroke-width="2.5" stroke-linecap="round" />
                <path d="M 45 12 C 62 0, 72 16, 56 26 C 65 34, 50 44, 38 30 Z" fill="#52a336" stroke="#1f3b08" stroke-width="2" />
                <circle cx="28" cy="24" r="10.5" fill="#a7c947" stroke="#2f4209" stroke-width="2" />
                <circle cx="44" cy="26" r="11" fill="#bdd95b" stroke="#2f4209" stroke-width="2" />
                <circle cx="20" cy="38" r="10.5" fill="#bdd95b" stroke="#2f4209" stroke-width="2" />
                <circle cx="36" cy="40" r="11.5" fill="#cce374" stroke="#2f4209" stroke-width="2" />
                <circle cx="54" cy="40" r="10.5" fill="#a7c947" stroke="#2f4209" stroke-width="2" />
                <circle cx="28" cy="54" r="10" fill="#a7c947" stroke="#2f4209" stroke-width="2" />
                <circle cx="45" cy="54" r="10.5" fill="#bdd95b" stroke="#2f4209" stroke-width="2" />
                <circle cx="36" cy="66" r="9.5" fill="#cce374" stroke="#2f4209" stroke-width="2" />
                <circle cx="33" cy="36" r="2.2" fill="#ffffff" fill-opacity="0.75" />
                <circle cx="42" cy="23" r="2" fill="#ffffff" fill-opacity="0.75" />
              </g>

              <!-- C. Rustic Mafra Bread Slices & Artisanal Toasts (Bottom Left-Center) -->
              <g transform="translate(388, 376) scale(0.82)">
                <path
                  d="M 0 32 C -6 12, 18 -4, 48 2 C 78 8, 92 26, 82 44 C 74 58, 12 50, 0 32 Z"
                  fill="#cfa166"
                  stroke="#3b2006"
                  stroke-width="2.5"
                />
                <path
                  d="M 8 30 C 4 16, 22 4, 46 8 C 70 12, 82 26, 74 40 C 66 50, 16 44, 8 30 Z"
                  fill="#f2DFB6"
                  stroke="#8a5a24"
                  stroke-width="1.5"
                />
                <circle cx="32" cy="24" r="2.5" fill="#b8894f" />
                <circle cx="52" cy="28" r="3" fill="#b8894f" />
                <circle cx="42" cy="34" r="2" fill="#b8894f" />

                <g transform="translate(58, 16) rotate(14)">
                  <ellipse cx="32" cy="22" rx="30" ry="18" fill="#ebc278" stroke="#4a2a08" stroke-width="2.2" />
                  <circle cx="20" cy="18" r="2" fill="#6b3e0e" />
                  <circle cx="32" cy="15" r="2" fill="#6b3e0e" />
                  <circle cx="44" cy="19" r="2" fill="#6b3e0e" />
                  <circle cx="26" cy="26" r="2" fill="#6b3e0e" />
                  <circle cx="38" cy="27" r="2" fill="#6b3e0e" />
                </g>
              </g>

              <!-- D. Fresh Cut Figs & Berries (Bottom Right-Center) -->
              <g transform="translate(710, 372) scale(0.82)">
                <path
                  d="M 18 28 C 18 12, 34 6, 40 0 C 46 6, 62 12, 62 28 C 62 44, 48 52, 40 52 C 32 52, 18 44, 18 28 Z"
                  fill="#592248"
                  stroke="#24081c"
                  stroke-width="2.4"
                />
                <g transform="translate(46, 18)">
                  <ellipse cx="28" cy="24" rx="26" ry="20" fill="#4a193b" stroke="#24081c" stroke-width="2.4" />
                  <ellipse cx="28" cy="24" rx="21" ry="15" fill="#f7e3c8" />
                  <ellipse cx="28" cy="24" rx="15" ry="10.5" fill="#d9435f" stroke="#a3223b" stroke-width="1.5" />
                  <circle cx="23" cy="21" r="1.2" fill="#fff3b0" />
                  <circle cx="28" cy="19" r="1.2" fill="#fff3b0" />
                  <circle cx="33" cy="22" r="1.2" fill="#fff3b0" />
                  <circle cx="25" cy="26" r="1.2" fill="#fff3b0" />
                  <circle cx="31" cy="27" r="1.2" fill="#fff3b0" />
                </g>
                <circle cx="12" cy="48" r="7" fill="#c9222b" stroke="#3d0609" stroke-width="1.8" />
                <circle cx="26" cy="56" r="6.5" fill="#e0313b" stroke="#3d0609" stroke-width="1.8" />
                <circle cx="98" cy="22" r="6.5" fill="#c9222b" stroke="#3d0609" stroke-width="1.8" />
              </g>

              <!-- E. Walnuts & Almonds Scattered on Board -->
              <g transform="translate(456, 298) scale(0.78)">
                <ellipse cx="22" cy="18" rx="16" ry="12" fill="#b87b3b" stroke="#3d2206" stroke-width="2.2" />
                <path d="M 10 18 C 16 12, 28 12, 34 18 M 14 22 C 20 26, 26 26, 30 22 M 22 8 L 22 28" fill="none" stroke="#4a2a08" stroke-width="1.6" />
                <ellipse cx="52" cy="26" rx="15" ry="11" transform="rotate(-18 52 26)" fill="#c98a47" stroke="#3d2206" stroke-width="2.2" />
                <path d="M 42 26 C 48 21, 56 21, 62 26 M 52 17 L 52 35" fill="none" stroke="#4a2a08" stroke-width="1.5" />
                <path d="M 28 38 C 36 30, 50 34, 46 44 C 42 50, 22 46, 28 38 Z" fill="#a86428" stroke="#3d2206" stroke-width="2" />
                <path d="M 66 10 C 74 2, 88 6, 84 16 C 80 22, 60 18, 66 10 Z" fill="#b87333" stroke="#3d2206" stroke-width="2" />
              </g>

              <!-- F. Olives (Left Edge) & Dried Apricots (Bottom Center) -->
              <g transform="translate(125, 225) scale(0.8)">
                <ellipse cx="18" cy="16" rx="11" ry="8" transform="rotate(-25 18 16)" fill="#6b8e23" stroke="#223006" stroke-width="2" />
                <circle cx="22" cy="14" r="2.5" fill="#d94e28" />
                <ellipse cx="36" cy="24" rx="10.5" ry="7.5" transform="rotate(15 36 24)" fill="#7da32b" stroke="#223006" stroke-width="2" />
                <ellipse cx="22" cy="34" rx="10" ry="7.5" transform="rotate(-10 22 34)" fill="#2e2930" stroke="#110e12" stroke-width="2" />
              </g>
              <g transform="translate(555, 418) scale(0.8)">
                <ellipse cx="22" cy="18" rx="18" ry="12" fill="#f28c28" stroke="#5c2c06" stroke-width="2" />
                <ellipse cx="48" cy="22" rx="17" ry="11" fill="#ffa343" stroke="#5c2c06" stroke-width="2" />
                <path d="M 72 14 C 80 6, 94 10, 90 20 C 86 26, 66 22, 72 14 Z" fill="#a86428" stroke="#3d2206" stroke-width="2" />
              </g>

              <!-- G. Small Artisanal Pumpkin Jam Pot on Right Board Edge -->
              <g transform="translate(1018, 262) scale(0.76)">
                <ellipse cx="34" cy="52" rx="28" ry="12" fill="#d99b26" stroke="#3b2306" stroke-width="2" />
                <path d="M 10 26 C 6 44, 14 58, 34 58 C 54 58, 62 44, 58 26 Z" fill="#f5eedc" stroke="#3b2306" stroke-width="2.4" />
                <ellipse cx="34" cy="26" rx="24" ry="9" fill="#ffffff" stroke="#3b2306" stroke-width="2.2" />
                <ellipse cx="34" cy="27" rx="19" ry="6.5" fill="url(#compota-orange-grad)" stroke="#9e6000" stroke-width="1.5" />
              </g>

              <!-- H. Rosemary Sprigs Adorning the Board -->
              <g stroke="#2d6e1e" stroke-width="2.2" fill="none" stroke-linecap="round">
                <path d="M 535 352 C 565 339, 600 334, 635 338" />
                <path d="M 550 346 L 542 332 M 556 344 L 566 354 M 574 339 L 568 326 M 580 338 L 590 348 M 598 336 L 594 323 M 604 336 L 615 346" />
              </g>
            </g>

            <!-- ============================================================ -->
            <!-- INTERACTIVE ZONE 1: QUEIJOS CURADOS (INSPIRED BY IMAGE 2)    -->
            <!-- Realistic golden dimpled cheese top wrapped all around in    -->
            <!-- its white paper wrapper (papel branco à volta de todo o      -->
            <!-- queijo).                                                     -->
            <!-- Normal: Fatia partida encostada junto ao queijo.             -->
            <!-- Hover: A fatia anda para trás/fora para notar-se!            -->
            <!-- ============================================================ -->
            <g
              class="cheese-board-zone zone-curados cursor-pointer"
              data-board-category="curados"
              data-active="false"
              role="button"
              tabindex="0"
              aria-label="Queijos Curados. Passe o rato para afastar a fatia partida e ver os queijos curados em baixo."
            >
              <!-- Generous invisible hover target for Curados -->
              <rect x="115" y="25" width="310" height="390" rx="28" fill="transparent" />

              <g class="curados-wheel-group">
                <!-- Realistic Drop Shadow under Curado Wheel -->
                <ellipse cx="278" cy="314" rx="124" ry="58" fill="#2b1704" fill-opacity="0.26" />

                <!-- Outer White Paper Collar/Wrapper around the Back & Right of the Wheel
                     (ensures the white paper wraps 360° around the entire cheese!) -->
                <path
                  d="M 162 238 A 118 56 0 1 1 398 238 L 398 304 A 118 56 0 0 1 390 324 L 390 258 A 118 56 0 1 0 162 238 Z"
                  fill="url(#curado-cinta-white)"
                  stroke="#2b1704"
                  stroke-width="2.5"
                  stroke-linejoin="round"
                />
                <!-- Back White Paper Rim Band encircling the top perimeter of the wheel -->
                <path
                  d="M 280 240 L 315 292 A 118 56 0 1 1 390 258 Z"
                  fill="#ffffff"
                  stroke="#2b1704"
                  stroke-width="2.5"
                  stroke-linejoin="round"
                />
                <!-- Subtle paper pleat lines along the back white paper rim -->
                <g stroke="#d4d0c5" stroke-width="1.4" stroke-linecap="round">
                  <line x1="176" y1="215" x2="184" y2="220" />
                  <line x1="198" y1="199" x2="205" y2="205" />
                  <line x1="226" y1="189" x2="231" y2="196" />
                  <line x1="258" y1="184" x2="260" y2="192" />
                  <line x1="292" y1="184" x2="290" y2="192" />
                  <line x1="324" y1="188" x2="320" y2="196" />
