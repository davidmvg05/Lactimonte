---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import NewsletterSection from '../components/sections/NewsletterSection.astro';
import { NEWS_ITEMS } from '../data/news';
---

<BaseLayout
  title="Notícias & Prémios | Atualidade Queijaria Lactimonte"
  description="Acompanhe as novidades, prémios Cinco Estrelas, Sabor do Ano, certificações de qualidade e artigos sobre a cultura queijeira da Lactimonte."
>
  <!-- Hero -->
  <section class="py-16 md:py-24 bg-[#ffffff] text-[#000000]">
    <div class="lacti-container">
      <div class="max-w-3xl space-y-5">
        <span class="font-script text-3xl md:text-4xl text-[#169f38] block">
          Arquivo Editorial & Distinções
        </span>
        <h1 class="font-sans text-4xl sm:text-5xl md:text-6xl font-black uppercase tracking-tight leading-[1.02] text-[#000000]">
          Notícias <span class="text-[#169f38]">Lactimonte</span>
        </h1>
        <p class="text-base md:text-xl leading-relaxed text-[#000000]">
          Prémios Cinco Estrelas, Sabor do Ano, certificações alimentares, reportagens na imprensa nacional e segredos de conservação dos nossos mestres queijeiros.
        </p>
      </div>
    </div>
  </section>

  <!-- News Grid -->
  <section class="py-16 md:py-24 bg-[#ffffff] text-[#000000]">
    <div class="lacti-container">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          NEWS_ITEMS.map((item) => (
            <article
              id={item.id}
              class="rounded-[28px] border-2 border-[#169f38] bg-[#ffffff] overflow-hidden flex flex-col justify-between transition-all duration-100"
            >
              <div>
                <div class="aspect-[16/10] bg-[#ffffff] border-b-2 border-[#169f38] overflow-hidden">
                  <img
                    src={item.image}
                    alt={item.title}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
                <div class="p-6 space-y-3">
                  <div class="flex items-center justify-between gap-2 text-xs font-black uppercase tracking-wider">
                    <span class="px-3 py-1 rounded-full bg-[#169f38] text-[#ffffff]">
                      {item.category}
                    </span>
                    <span class="text-[#000000]">{item.formattedDate}</span>
                  </div>
                  <h2 class="font-sans text-xl font-black uppercase leading-snug text-[#169f38]">
                    {item.title}
                  </h2>
                  <p class="text-sm leading-relaxed text-[#000000]">
                    {item.excerpt}
                  </p>
                </div>
              </div>

              <div class="px-6 pb-6 pt-2">
                <Button
                  href="/contactos"
                  variant="secondary"
                  size="sm"
                  icon="arrow-up-right"
                  label="Saber Mais / Imprensa"
                />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <NewsletterSection />
</BaseLayout>
