---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/sections/HeroSlider.astro';
import ProductsShowcase from '../components/sections/ProductsShowcase.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import RecipesShowcase from '../components/sections/RecipesShowcase.astro';
---

<BaseLayout
  title="Lactimonte | Queijaria Tradicional de Mafra desde 1980"
  description="Queijaria Lactimonte: produção e distribuição de queijos frescos, queijos curados e requeijão tradicional em Montemuro, Mafra desde 1980. Prémio Cinco Estrelas e Sabor do Ano."
>
  <!-- Main Interactive Slides Section -->
  <HeroSlider />

  <!-- Segunda Secção: O Sabor Puro da Região Saloia -->
  <ProductsShowcase />

  <!-- Terceira Secção: Sobre Nós / A Marca -->
  <AboutSection />

  <!-- Quarta Secção: Monte de Receitas -->
  <RecipesShowcase />
</BaseLayout>
