---
import Icon from '../ui/Icon.astro';

export interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

// Menu items as requested: marca / queijos / receitas / raízes / mural
const navItems = [
  { label: 'marca', href: '/a-lactimonte' },
  { label: 'queijos', href: '/queijos' },
  { label: 'receitas', href: '/receitas' },
  { label: 'raízes', href: '/raizes' },
  { label: 'mural', href: '/noticias' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-[#ffffff] transition-transform duration-300 ease-in-out will-change-transform"
>
  <!-- Main Header Navigation Bar -->
  <div class="lacti-container py-3.5 flex items-center justify-between gap-4">
    <!-- Brand Logo (Moved slightly more to the left) -->
    <a
      href="/"
      class="group inline-flex items-center gap-3 focus-visible:outline-[#169f38] rounded-2xl -ml-1 sm:-ml-3"
      aria-label="Lactimonte — Voltar à Página Inicial"
    >
      <img
        src="/assets/logo/logo_lactimonte.png"
        alt="Logótipo Lactimonte"
        width="150"
        height="60"
        class="h-12 sm:h-14 w-auto object-contain group-hover:scale-[1.02] transition-transform duration-instant"
        fetchpriority="high"
      />
    </a>

    <!-- Desktop Navigation: Placed on the right side with script font and green hover -->
    <nav aria-label="Navegação Principal" class="hidden lg:flex items-center gap-7 xl:gap-9 ml-auto">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class={`font-script text-2xl sm:text-3xl lowercase tracking-wide transition-colors duration-150 text-[#169f38] hover:text-[#1e1e1e] ${
              isActive(item.href) ? 'font-bold' : ''
            }`}
          >
            {item.label}
          </a>
        ))
      }

      <!-- Search Magnifying Glass Icon Button (Placed right after mural) -->
      <button
        type="button"
        data-search-trigger
        aria-label="Pesquisar receitas"
        class="text-[#169f38] hover:text-[#1e1e1e] transition-colors duration-150 p-1 rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#169f38]"
      >
        <Icon name="search" size={18} />
      </button>
    </nav>

    <!-- Mobile Actions (Search trigger + Hamburger menu) -->
    <div class="flex lg:hidden items-center gap-2">
      <button
        type="button"
        data-search-trigger
        aria-label="Pesquisar receitas"
        class="text-[#169f38] hover:text-[#1e1e1e] transition-colors p-1.5 rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#169f38]"
      >
        <Icon name="search" size={18} />
      </button>

      <!-- Mobile Menu Toggle Button (44x44px minimum target WCAG 2.5.5) -->
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="Abrir menu de navegação"
        class="btn-lacti btn-lacti-sm btn-lacti-secondary btn-lacti-icon-only"
      >
        <span id="mobile-icon-open">
          <Icon name="menu" size={20} />
        </span>
        <span id="mobile-icon-close" class="hidden">
          <Icon name="close" size={20} />
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-nav-drawer"
    class="hidden lg:hidden bg-[#ffffff] border-t-2 border-[#169f38] px-6 py-6 space-y-4"
  >
    <nav aria-label="Navegação Mobile" class="flex flex-col gap-3">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class={`font-script text-3xl lowercase tracking-wide transition-colors duration-150 flex items-center justify-between py-1.5 text-[#169f38] hover:text-[#1e1e1e] ${
              isActive(item.href) ? 'font-bold' : ''
            }`}
          >
            <span>{item.label}</span>
            <Icon name="arrow-up-right" size={18} class="text-[#169f38]" />
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  function initMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');
    const iconOpen = document.getElementById('mobile-icon-open');
    const iconClose = document.getElementById('mobile-icon-close');

    if (!toggleBtn || !drawer) return;

    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      toggleBtn.setAttribute(
        'aria-label',
        !isExpanded ? 'Fechar menu de navegação' : 'Abrir menu de navegação'
      );
      drawer.classList.toggle('hidden', isExpanded);
      iconOpen?.classList.toggle('hidden', !isExpanded);
      iconClose?.classList.toggle('hidden', isExpanded);
    });
  }

  function initSmartHeader() {
    const header = document.getElementById('site-header');
    const drawer = document.getElementById('mobile-nav-drawer');
    if (!header) return;

    let lastScrollY = window.scrollY;
    let ticking = false;

    function handleScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const currentScrollY = window.scrollY;
          const isDrawerOpen = drawer && !drawer.classList.contains('hidden');

          // Always keep header visible if mobile drawer is currently open
          if (isDrawerOpen) {
            header.classList.remove('-translate-y-full');
            lastScrollY = currentScrollY;
            ticking = false;
            return;
          }

          // Always keep header visible at the very top of the page
          if (currentScrollY <= 15) {
            header.classList.remove('-translate-y-full');
            lastScrollY = currentScrollY;
            ticking = false;
            return;
          }

          const diff = currentScrollY - lastScrollY;

          // Ignore subtle finger/wheel micro-shifts
          if (Math.abs(diff) < 8) {
            ticking = false;
            return;
          }

          if (diff > 0 && currentScrollY > 70) {
            // Scrolling down -> hide header out of view to focus on content
            header.classList.add('-translate-y-full');
          } else if (diff < 0) {
            // Scrolling up ("scroll para trás") -> reveal header smoothly
            header.classList.remove('-translate-y-full');
          }

          lastScrollY = currentScrollY;
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
  }

  function setupHeader() {
    initMobileMenu();
    initSmartHeader();
  }

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>
