---
import Button from '../ui/Button.astro';

interface ProductDetail {
  id: string;
  name: string;
  watermark: string;
  image: string;
  href: string;
  textureLabel: string;
  textureDesc: string;
  pairingLabel: string;
  pairingDesc: string;
}

const products: ProductDetail[] = [
  {
    id: 'curados',
    name: 'Queijo Curado',
    watermark: 'CURADO',
    image: '/assets/imagem/slide_produtos/categoria-queijos-curados.png',
    href: '/queijos#curados',
    textureLabel: 'Textura & Pasta',
    textureDesc: 'Semi-dura e untuosa, fruto de uma maturação lenta e vigilante.',
    pairingLabel: 'Harmonização de Mesa',
    pairingDesc: 'Pão de Mafra com côdea estaladiça, nozes e compotas rústicas.',
  },
  {
    id: 'frescos',
    name: 'Queijo Fresco',
    watermark: 'FRESCO',
    image: '/assets/imagem/slide_produtos/categoria-queijo-frescos.png',
    href: '/queijos#frescos',
    textureLabel: 'Textura & Pasta',
    textureDesc: 'Húmida, fresca e delicada, com o corte suave tradicional saloio.',
    pairingLabel: 'Harmonização de Mesa',
    pairingDesc: 'Salada de tomate da horta, azeite virgem extra e orégãos secos.',
  },
  {
    id: 'requeijao',
    name: 'Requeijão',
    watermark: 'REQUEIJÃO',
    image: '/assets/imagem/slide_produtos/categoria-requeijoes.png',
    href: '/queijos#requeijao',
    textureLabel: 'Textura & Pasta',
    textureDesc: 'Aveludada, cremosa e com granulação fina de digestão ligeira.',
    pairingLabel: 'Harmonização de Mesa',
    pairingDesc: 'Colher de mel de urze das serras, nozes e doce de abóbora caseiro.',
  },
];
---

<section
  id="produtos-destaque"
  class="relative pt-16 pb-12 sm:pt-20 sm:pb-14 md:pt-28 md:pb-16 bg-[#ffffff] text-[#1e1e1e] overflow-hidden select-none"
  aria-label="Apresentação de Produtos Lactimonte"
>
  <!-- Background: Flores de Cardo Tradicionais (Coagulante Vegetal Natural do Queijo) em PNG com Animação de Vento no Scroll -->
  <div class="absolute inset-0 pointer-events-none z-0 overflow-hidden">
    <!-- Flor de Cardo Saloio (Saindo do bordo lateral esquerdo do ecrã) -->
    <div class="absolute top-1/4 -left-6 sm:-left-8 md:-left-10 w-40 sm:w-52 md:w-64 lg:w-72 pointer-events-none select-none z-0">
      <img
        id="botanical-branch-left"
        src="/assets/imagem/botanica/ramo-cardo-esquerdo.png"
        alt="Flor de Cardo tradicional para coagulação do queijo"
        class="w-full h-auto object-contain drop-shadow-[0_12px_24px_rgba(0,0,0,0.14)] will-change-transform origin-left rotate-45"
        loading="eager"
      />
    </div>

    <!-- Flor de Cardo Saloio com Botão (Saindo do bordo lateral direito do ecrã) -->
    <div class="absolute top-1/4 -right-6 sm:-right-8 md:-right-10 w-40 sm:w-52 md:w-64 lg:w-72 pointer-events-none select-none z-0">
      <img
        id="botanical-branch-right"
        src="/assets/imagem/botanica/ramo-cardo-direito.png"
        alt="Flor de Cardo tradicional para coagulação do queijo"
        class="w-full h-auto object-contain drop-shadow-[0_12px_24px_rgba(0,0,0,0.14)] will-change-transform origin-right -rotate-45"
        loading="eager"
      />
    </div>
  </div>

  <div class="lacti-container relative z-10">
    <!-- Zona Interativa Delimitada (Área onde as setas atuam como rato) -->
    <div id="showcase-interactive-zone" class="relative max-w-5xl mx-auto rounded-[60px] md:rounded-[80px]">
      <!-- Section Title: "O" and "da" in #1e1e1e, "Sabor Puro" and "Região Saloia" in #169f38 -->
      <div class="text-center pt-2 mb-8 sm:mb-12">
        <h2 class="font-sans text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tight text-center">
          <span class="text-[#1e1e1e]">O</span> <span class="text-[#169f38]">Sabor Puro</span> <span class="text-[#1e1e1e]">da</span> <span class="text-[#169f38]">Região Saloia</span>
        </h2>
      </div>

      <!-- Main Showcase Stage -->
      <div
        id="showcase-stage"
        class="relative min-h-[460px] sm:min-h-[500px] md:min-h-[540px] flex flex-col items-center justify-center rounded-3xl"
      >
        <!-- Watermark Typography in Roboto com Tom Verde da Variante A (font-black, tracking-[0.25em], ~8% opacidade verde) - ligeiramente descido -->
        <div class="absolute inset-x-0 top-16 sm:top-20 md:top-24 flex items-center justify-center pointer-events-none select-none z-0">
          {
            products.map((p, idx) => (
              <span
                class={`product-watermark absolute font-sans font-black uppercase text-6xl sm:text-8xl md:text-9xl lg:text-[11rem] tracking-[0.25em] transition-all duration-500 ease-out text-[#169f38]/[0.08] whitespace-nowrap ${
                  idx === 0
                    ? 'translate-y-0 opacity-100'
                    : 'translate-y-10 opacity-0'
                }`}
                data-watermark-idx={idx}
              >
                {p.watermark}
              </span>
            ))
          }
        </div>

        <!-- Stage Grid: Left Floating Card + Center Cheese Image + Right Floating Card -->
        <!-- Espaçamento ampliado para empurrar o card esquerdo mais para a esquerda e o direito mais para a direita -->
        <div class="relative z-10 w-full flex flex-col md:flex-row items-center justify-between gap-6 px-0 sm:px-2 md:px-0">
          
          <!-- Micro-Card 1: Textura & Pasta (Flutuante à Esquerda, mais afastado para a esquerda) -->
          <div
            id="micro-card-left"
            class="w-full md:w-64 order-2 md:order-1 flex justify-center md:justify-start -translate-x-0 md:-translate-x-8 lg:-translate-x-12 transition-transform duration-700 ease-out will-change-transform"
          >
            <div class="backdrop-blur-md bg-[#ffffff]/90 border border-[#169f38]/25 shadow-[0_12px_32px_-6px_rgba(22,159,56,0.10)] rounded-2xl p-5 sm:p-6 w-full max-w-[270px] transition-all duration-300 hover:border-[#169f38]/50">
              <div class="mb-2">
                <span id="product-texture-title" class="font-sans text-xs uppercase font-bold tracking-wider text-[#169f38]">
                  {products[0].textureLabel}
                </span>
              </div>
              <p
                id="product-texture-desc"
                class="font-script text-xl sm:text-2xl text-[#1e1e1e] leading-[1.3] font-normal tracking-wide"
              >
                {products[0].textureDesc}
              </p>
            </div>
          </div>

          <!-- Central Product Image (Limpo, nítido e em destaque, sem link para não interferir com a navegação do carrossel) -->
          <div class="relative w-full max-w-xs sm:max-w-sm md:max-w-md aspect-square flex items-center justify-center order-1 md:order-2 pointer-events-none">
            {
              products.map((p, idx) => (
                <div
                  class={`product-img-slide absolute inset-0 flex items-center justify-center transition-all duration-500 ease-in-out ${
                    idx === 0
                      ? 'opacity-100 scale-100'
                      : 'opacity-0 scale-95'
                  }`}
                  data-img-idx={idx}
                >
                  <img
                    src={p.image}
                    alt={p.name}
                    class="max-w-[85%] max-h-[85%] object-contain drop-shadow-[0_24px_35px_rgba(30,30,30,0.20)] pointer-events-none"
                    loading={idx === 0 ? 'eager' : 'lazy'}
                  />
                </div>
              ))
            }
          </div>

          <!-- Micro-Card 2: Harmonização de Mesa (Flutuante à Direita, mais afastado para a direita e posicionado mais para baixo) -->
          <div
            id="micro-card-right"
            class="w-full md:w-64 order-3 flex justify-center md:justify-end translate-x-0 md:translate-x-8 lg:translate-x-12 translate-y-8 md:translate-y-12 transition-transform duration-700 ease-out will-change-transform"
          >
            <div class="backdrop-blur-md bg-[#ffffff]/90 border border-[#169f38]/25 shadow-[0_12px_32px_-6px_rgba(22,159,56,0.10)] rounded-2xl p-5 sm:p-6 w-full max-w-[270px] transition-all duration-300 hover:border-[#169f38]/50">
              <div class="mb-2">
                <span id="product-pairing-title" class="font-sans text-xs uppercase font-bold tracking-wider text-[#169f38]">
                  {products[0].pairingLabel}
                </span>
              </div>
              <p
                id="product-pairing-desc"
                class="font-script text-xl sm:text-2xl text-[#1e1e1e] leading-[1.3] font-normal tracking-wide"
              >
                {products[0].pairingDesc}
              </p>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Botão Ver Produtos (Variação 1 — Primário) — Subido mais um pouco -->
    <div class="relative z-20 mt-1 sm:mt-2 md:mt-3 flex items-center justify-center">
      <Button
        id="btn-ver-produtos"
        href="/queijos"
        variant="primary"
        size="md"
        ariaLabel="Ver todos os produtos na página dos queijos"
      >
        Ver produtos
      </Button>
    </div>
  </div>

  <!-- Seta-Cursor Customizada (Visível apenas dentro do raio da zona interativa) -->
  <div
    id="product-arrow-cursor"
    class="fixed top-0 left-0 pointer-events-none z-50 transition-opacity duration-150 opacity-0 -translate-x-1/2 -translate-y-1/2 will-change-transform"
    aria-hidden="true"
  >
    <!-- Seta para a Esquerda (<) - idêntica em tamanho (38px) e espessura (stroke-width 2) à seta branca do hero -->
    <svg
      id="cursor-arrow-left"
      class="w-[38px] h-[38px] text-[#1e1e1e] drop-shadow-[0_2px_8px_rgba(0,0,0,0.18)] transition-transform duration-100 ease-out hidden"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m15 18-6-6 6-6"></path>
    </svg>

    <!-- Seta para a Direita (>) - idêntica em tamanho (38px) e espessura (stroke-width 2) à seta branca do hero -->
    <svg
      id="cursor-arrow-right"
      class="w-[38px] h-[38px] text-[#1e1e1e] drop-shadow-[0_2px_8px_rgba(0,0,0,0.18)] transition-transform duration-100 ease-out hidden"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m9 18 6-6-6-6"></path>
    </svg>
  </div>
</section>

<style>
  @media (hover: hover) and (pointer: fine) {
    /* Oculta o cursor nativo apenas quando o rato está dentro da zona interativa */
    #produtos-destaque.in-interactive-zone,
    #produtos-destaque.in-interactive-zone *:not(#btn-ver-produtos):not(#btn-ver-produtos *) {
      cursor: none !important;
    }
    #btn-ver-produtos,
    #btn-ver-produtos * {
      cursor: pointer !important;
    }
  }
</style>

<script>
  function initProductsShowcase() {
    const section = document.getElementById('produtos-destaque');
    const zone = document.getElementById('showcase-interactive-zone');
    const cursorEl = document.getElementById('product-arrow-cursor');
    const arrowLeft = document.getElementById('cursor-arrow-left');
    const arrowRight = document.getElementById('cursor-arrow-right');
    const branchLeft = document.getElementById('botanical-branch-left');
    const branchRight = document.getElementById('botanical-branch-right');

    if (!section || !zone || !cursorEl || !arrowLeft || !arrowRight) return;

    const watermarks = section.querySelectorAll<HTMLElement>('.product-watermark');
    const images = section.querySelectorAll<HTMLElement>('.product-img-slide');
    const textureTitle = document.getElementById('product-texture-title');
    const textureDesc = document.getElementById('product-texture-desc');
    const pairingTitle = document.getElementById('product-pairing-title');
    const pairingDesc = document.getElementById('product-pairing-desc');

    const productsData = [
      {
        textureTitle: 'Textura & Pasta',
        textureDesc: 'Semi-dura e untuosa, fruto de uma maturação lenta e vigilante.',
        pairingTitle: 'Harmonização de Mesa',
        pairingDesc: 'Pão de Mafra com côdea estaladiça, nozes e compotas rústicas.',
      },
      {
        textureTitle: 'Textura & Pasta',
        textureDesc: 'Húmida, fresca e delicada, com o corte suave tradicional saloio.',
        pairingTitle: 'Harmonização de Mesa',
        pairingDesc: 'Salada de tomate da horta, azeite virgem extra e orégãos secos.',
      },
      {
        textureTitle: 'Textura & Pasta',
        textureDesc: 'Aveludada, cremosa e com granulação fina de digestão ligeira.',
        pairingTitle: 'Harmonização de Mesa',
        pairingDesc: 'Colher de mel de urze das serras, nozes e doce de abóbora caseiro.',
      },
    ];

    const cardLeft = document.getElementById('micro-card-left');
    const cardRight = document.getElementById('micro-card-right');

    const total = images.length;
    let currentIndex = 0;
    let isAnimating = false;

    // Atualiza a posição vertical alternada dos micro-cards conforme o índice do produto:
    // Produto 0: Esquerda normal (0), Direita mais para baixo (+32px)
    // Produto 1: Esquerda desce (+28px), Direita sobe (-16px)
    // Produto 2: Esquerda sobe (-20px), Direita desce (+36px)
    function updateCardVerticalPositions(index: number) {
      if (!cardLeft || !cardRight) return;
      const isDesktop = window.innerWidth >= 768;
      if (!isDesktop) {
        cardLeft.style.transform = '';
        cardRight.style.transform = '';
        return;
      }

      if (index === 0) {
        cardLeft.style.transform = 'translate3d(-32px, 0px, 0)';
        cardRight.style.transform = 'translate3d(32px, 48px, 0)';
      } else if (index === 1) {
        // Direita sobe e esquerda desce
        cardLeft.style.transform = 'translate3d(-32px, 44px, 0)';
        cardRight.style.transform = 'translate3d(32px, -20px, 0)';
      } else {
        // Terceiro produto: Direita desce e esquerda sobe
        cardLeft.style.transform = 'translate3d(-32px, -24px, 0)';
        cardRight.style.transform = 'translate3d(32px, 52px, 0)';
      }
    }

    // Inicializar posições verticais no carregamento
    updateCardVerticalPositions(0);
    window.addEventListener('resize', () => updateCardVerticalPositions(currentIndex));

    // Posições do rato
    let mouseClientX = -1000;
    let mouseClientY = -1000;

    // Cálculo exato da forma oval/elíptica correspondente ao círculo desenhado
    function checkMouseInZone(clientX: number, clientY: number): boolean {
      const rect = zone.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const rx = rect.width / 2;
      const ry = rect.height / 2;

      // Fórmula super-elíptica para formato pílula/oval conforme o desenho vermelho
      const dx = Math.abs(clientX - cx) / rx;
      const dy = Math.abs(clientY - cy) / ry;
      return Math.pow(dx, 2.6) + Math.pow(dy, 2.6) <= 1.0;
    }

    function updateArrowDirection(clientX: number): boolean {
      const rect = zone.getBoundingClientRect();
      const isLeft = (clientX - rect.left) < (rect.width / 2);
      if (isLeft) {
        arrowLeft.classList.remove('hidden');
        arrowRight.classList.add('hidden');
      } else {
        arrowRight.classList.remove('hidden');
        arrowLeft.classList.add('hidden');
      }
      return isLeft;
    }

    function updateCursorState(clientX: number, clientY: number) {
      const isInside = checkMouseInZone(clientX, clientY);

      if (isInside) {
        section.classList.add('in-interactive-zone');
        cursorEl.classList.remove('opacity-0');
        cursorEl.classList.add('opacity-100');
        updateArrowDirection(clientX);
      } else {
        section.classList.remove('in-interactive-zone');
        cursorEl.classList.remove('opacity-100');
        cursorEl.classList.add('opacity-0');
      }
    }

    // Seguir o rato e testar o raio de ação
    section.addEventListener('mousemove', (e) => {
      mouseClientX = e.clientX;
      mouseClientY = e.clientY;

      cursorEl.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0)`;
      updateCursorState(e.clientX, e.clientY);
    });

    section.addEventListener('mouseleave', () => {
      mouseClientX = -1000;
      mouseClientY = -1000;
      section.classList.remove('in-interactive-zone');
      cursorEl.classList.remove('opacity-100');
      cursorEl.classList.add('opacity-0');
    });

    // Feedback táctil no clique
    section.addEventListener('mousedown', (e) => {
      if (checkMouseInZone(e.clientX, e.clientY)) {
        arrowLeft.classList.add('scale-75');
        arrowRight.classList.add('scale-75');
      }
    });

    window.addEventListener('mouseup', () => {
      arrowLeft.classList.remove('scale-75');
      arrowRight.classList.remove('scale-75');
    });

    // Clique na secção só avança/recua se o utilizador estiver dentro da zona
    section.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('#btn-ver-produtos')) {
        return; // Permite a navegação normal do botão
      }

      if (checkMouseInZone(e.clientX, e.clientY)) {
        const isLeft = updateArrowDirection(e.clientX);
        if (isLeft) {
          goToProduct((currentIndex - 1 + total) % total);
        } else {
          goToProduct((currentIndex + 1) % total);
        }
      }
    });

    // Transição entre produtos
    function goToProduct(nextIndex: number) {
      if (isAnimating || nextIndex === currentIndex) return;
      isAnimating = true;

      // Alternância de alturas dos micro-cards (um sobe outro desce)
      updateCardVerticalPositions(nextIndex);

      // Atualizar Marca d'Água (Tom Verde)
      watermarks[currentIndex]?.classList.remove('translate-y-0', 'opacity-100');
      watermarks[currentIndex]?.classList.add('translate-y-10', 'opacity-0');
      watermarks[nextIndex]?.classList.remove('translate-y-10', 'opacity-0');
      watermarks[nextIndex]?.classList.add('translate-y-0', 'opacity-100');

      // Atualizar Imagem com Crossfade em posição fixa e animação vertical alternada (contrário ao que passou)
      // Produto 0: elevação neutra (0), Produto 1: desce ligeiramente (+12px), Produto 2: sobe ligeiramente (-12px)
      const cheeseYOffsets = [0, 14, -14];
      const cheeseY = cheeseYOffsets[nextIndex % cheeseYOffsets.length];

      images.forEach((imgEl, idx) => {
        if (idx === nextIndex) {
          imgEl.classList.remove('opacity-0', 'scale-95');
          imgEl.classList.add('opacity-100', 'scale-100');
          imgEl.style.transform = `translate3d(0, ${cheeseY}px, 0)`;
        } else {
          imgEl.classList.remove('opacity-100', 'scale-100');
          imgEl.classList.add('opacity-0', 'scale-95');
        }
      });

      // Atualizar Micro-Cards Flutuantes com fade suave
      const data = productsData[nextIndex];
      if (data) {
        if (textureTitle) textureTitle.textContent = data.textureTitle;
        if (textureDesc) textureDesc.textContent = data.textureDesc;
        if (pairingTitle) pairingTitle.textContent = data.pairingTitle;
        if (pairingDesc) pairingDesc.textContent = data.pairingDesc;
      }

      currentIndex = nextIndex;

      setTimeout(() => {
        isAnimating = false;
      }, 550);
    }

    // -------------------------------------------------------------
    // ANIMAÇÃO DE VENTO NOS RAMOS BOTÂNICOS AO FAZER SCROLL
    // -------------------------------------------------------------
    let lastScrollY = window.scrollY;
    let scrollVelocity = 0;
    let currentAngleLeft = 0;
    let currentAngleRight = 0;

    window.addEventListener(
      'scroll',
      () => {
        const currentY = window.scrollY;
        const delta = currentY - lastScrollY;
        lastScrollY = currentY;

        // Impulso do vento proporcional à velocidade do scroll
        scrollVelocity += delta * 0.22;

        // Atualiza a presença do rato na zona se o utilizador fizer scroll
        if (mouseClientX >= 0 && mouseClientY >= 0) {
          updateCursorState(mouseClientX, mouseClientY);
        }
      },
      { passive: true }
    );

    function animateWind() {
      // Amortecimento aerodinâmico (resistência do ar)
      scrollVelocity *= 0.88;

      // Brisa natural contínua subtil
      const time = performance.now() * 0.0028;
      const breeze = Math.sin(time) * 2.2;

      const targetLeft = Math.max(-18, Math.min(18, scrollVelocity * 0.8)) + breeze;
      const targetRight = Math.max(-18, Math.min(18, -scrollVelocity * 0.8)) - breeze;

      currentAngleLeft += (targetLeft - currentAngleLeft) * 0.14;
      currentAngleRight += (targetRight - currentAngleRight) * 0.14;

      // Base: ramo esquerdo a 45 graus, ramo direito a -45 graus, saindo dos lados do ecrã
      if (branchLeft) {
        branchLeft.style.transform = `rotate(${45 + currentAngleLeft}deg)`;
      }
      if (branchRight) {
        branchRight.style.transform = `rotate(${-45 + currentAngleRight}deg)`;
      }

      requestAnimationFrame(animateWind);
    }

    animateWind();

    // Suporte a Swipe Táctil (Mobile)
    let touchStartX = 0;
    section.addEventListener(
      'touchstart',
      (e) => {
        touchStartX = e.touches[0].clientX;
      },
      { passive: true }
    );

    section.addEventListener(
      'touchend',
      (e) => {
        const touchEndX = e.changedTouches[0].clientX;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 40) {
          if (diff > 0) {
            goToProduct((currentIndex + 1) % total);
          } else {
            goToProduct((currentIndex - 1 + total) % total);
          }
        }
      },
      { passive: true }
    );
  }

  initProductsShowcase();
  document.addEventListener('astro:page-load', initProductsShowcase);
</script>
