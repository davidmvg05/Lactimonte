---
import { RECIPES, type RecipeItem } from '../../data/recipes';
import Icon from '../ui/Icon.astro';

export interface Props {
  limit?: number;
  showFilters?: boolean;
  title?: string;
  subtitle?: string;
}

const {
  limit,
  showFilters = false,
  title = 'Receitas em Carrossel 360°',
  subtitle = 'Inspiração à Mesa com Lactimonte',
} = Astro.props;

const displayedRecipes: RecipeItem[] = limit
  ? RECIPES.filter((r) => r.featuredOnHome).slice(0, limit)
  : RECIPES;

const firstRecipe = displayedRecipes[0];

const categories = [
  'Todas',
  'Saladas Frescas',
  'Entradas & Petiscos',
  'Pratos Principais',
  'Sobremesas',
];
---

<section
  class="py-16 md:py-24 bg-[#ffffff] text-[#000000] overflow-hidden"
  aria-labelledby="videoreel-section-heading"
  data-videoreel-section
>
  <div class="lacti-container">
    <!-- Section Header -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10">
      <div>
        <span class="font-script text-3xl md:text-4xl text-[#169f38] block mb-2">
          {subtitle}
        </span>
        <h2
          id="videoreel-section-heading"
          class="font-sans text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight leading-[1.05] text-[#000000]"
        >
          {title}
        </h2>
      </div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <p class="max-w-md text-sm md:text-base text-[#000000] border-l-4 border-[#169f38] pl-4">
          Arraste os vídeos para os lados com o <strong>rato (mão aberta / fechada)</strong> ou use as <strong>setas à esquerda e à direita</strong>. O texto e o botão <strong>Ver receita</strong> em baixo mudam a cada vídeo.
        </p>
      </div>
    </div>

    <!-- Optional Category Filter Pills (shown on /receitas page) -->
    {
      showFilters && (
        <div
          class="flex flex-wrap items-center justify-center gap-3 mb-10"
          role="tablist"
          aria-label="Filtrar receitas por categoria"
        >
          {categories.map((cat, idx) => (
            <button
              type="button"
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
              data-recipe-filter={cat}
              class={`btn-lacti btn-lacti-sm ${
                idx === 0 ? 'btn-lacti-primary' : 'btn-lacti-secondary'
              }`}
            >
              <span class="btn-label">{cat}</span>
              <span class="btn-icon icon-default" aria-hidden="true">
                <Icon name="utensils" size={16} />
              </span>
              <span class="btn-icon icon-confirmed" aria-hidden="true">
                <Icon name="check-circle" size={16} />
              </span>
            </button>
          ))}
        </div>
      )
    }

    <!-- =================================================================== -->
    <!-- 360° VIDEOREEL CAROUSEL (Inspired by videoreelpro.framer.website)   -->
    <!-- - Left Arrow on Left Side & Right Arrow on Right Side               -->
    <!-- - Open Hand (grab) / Closed Hand when dragging (grabbing)           -->
    <!-- - ZERO text inside the video image                                  -->
    <!-- =================================================================== -->
    <div
      class="relative flex items-center justify-center my-2"
      data-carousel-root
      tabindex="0"
      aria-roledescription="carrossel 360 de vídeos de receitas"
      aria-label="Carrossel 360 de vídeos de receitas. Use as setas esquerda e direita ou arraste com o rato."
    >
      <!-- LEFT ARROW BUTTON (Left Side of the Carousel) -->
      <button
        type="button"
        data-carousel-prev
        class="btn-lacti btn-lacti-secondary !p-0 w-12 h-12 sm:w-14 sm:h-14 rounded-full absolute left-0 sm:left-2 md:left-4 lg:left-6 top-1/2 -translate-y-1/2 z-40"
        aria-label="Vídeo anterior"
      >
        <span class="btn-icon icon-default" aria-hidden="true">
          <Icon name="chevron-left" size={24} />
        </span>
        <span class="btn-icon icon-confirmed" aria-hidden="true">
          <Icon name="chevron-left" size={24} />
        </span>
      </button>

      <!-- 360° DRAGGABLE VIDEO STAGE (Mão aberta: grab / Mão fechada ao arrastar: grabbing) -->
      <div
        class="videoreel-360-stage"
        data-carousel-stage
      >
        {
          displayedRecipes.map((recipe, index) => (
            <div
              class="videoreel-360-card group"
              data-carousel-card
              data-card-index={index}
              data-recipe-id={recipe.id}
              data-recipe-category={recipe.category}
              data-active={index === 0 ? 'true' : 'false'}
              role="group"
              aria-roledescription="vídeo"
              aria-label={recipe.title}
            >
              <!-- Pure Video Visual (ZERO text inside the video card image) -->
              <img
                src={recipe.image}
                alt={recipe.title}
                class="videoreel-media w-full h-full object-cover"
                draggable="false"
                loading={index <= 2 || index >= displayedRecipes.length - 2 ? 'eager' : 'lazy'}
              />

              <!-- Subtle Icon-Only Play/Sound Indicator (No text on the video image) -->
              <div
                class="absolute top-4 right-4 z-10 w-10 h-10 rounded-full bg-[#ffffff] text-[#169f38] border-2 border-[#169f38] flex items-center justify-center opacity-0 group-data-[active=true]:opacity-100 transition-opacity duration-150 pointer-events-none"
                aria-hidden="true"
              >
                <Icon name="play" size={18} />
              </div>

              <!-- Active Video Progress Bar at Bottom Edge -->
              <div
                class="absolute bottom-0 left-0 right-0 h-1.5 bg-[#ffffff]/60 overflow-hidden opacity-0 group-data-[active=true]:opacity-100 transition-opacity duration-150 pointer-events-none"
                aria-hidden="true"
              >
                <div class="h-full w-full bg-[#169f38] origin-left animate-pulse"></div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- RIGHT ARROW BUTTON (Right Side of the Carousel) -->
      <button
        type="button"
        data-carousel-next
        class="btn-lacti btn-lacti-secondary !p-0 w-12 h-12 sm:w-14 sm:h-14 rounded-full absolute right-0 sm:right-2 md:right-4 lg:right-6 top-1/2 -translate-y-1/2 z-40"
        aria-label="Próximo vídeo"
      >
        <span class="btn-icon icon-default" aria-hidden="true">
          <Icon name="chevron-right" size={24} />
        </span>
        <span class="btn-icon icon-confirmed" aria-hidden="true">
          <Icon name="chevron-right" size={24} />
        </span>
      </button>
    </div>

    <!-- =================================================================== -->
    <!-- DYNAMIC RECIPE TEXT & "VER RECEITA" PANEL OUTSIDE & BELOW THE VIDEO -->
    <!-- Updates automatically whenever the active video changes!            -->
    <!-- =================================================================== -->
    {
      firstRecipe && (
        <div
          class="max-w-2xl mx-auto mt-6 p-6 sm:p-8 rounded-[28px] border-2 border-[#169f38] bg-[#ffffff] text-center space-y-4 transition-all duration-150"
          data-active-recipe-panel
          aria-live="polite"
        >
          <!-- Top Meta Badges: 360° Counter + Cheese Used + Prep Time -->
          <div class="flex flex-wrap items-center justify-center gap-2">
            <span
              data-active-counter
              class="inline-flex items-center px-3 py-1 rounded-full bg-[#169f38] text-[#ffffff] text-xs font-black uppercase tracking-wider"
            >
              1 / {displayedRecipes.length}
            </span>

            <span
              data-active-cheese
              class="inline-flex items-center px-3.5 py-1 rounded-full bg-[#ffffff] text-[#169f38] border-2 border-[#169f38] text-xs font-black uppercase tracking-wider"
            >
              {firstRecipe.cheeseUsed}
            </span>

            <span
              data-active-meta
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#ffffff] text-[#000000] border-2 border-[#169f38] text-xs font-bold uppercase tracking-wider"
            >
              <Icon name="clock" size={13} class="text-[#169f38]" />
              <span>{firstRecipe.prepTime} • {firstRecipe.difficulty}</span>
            </span>
          </div>

          <!-- Active Video Recipe Title (Changes when video changes) -->
          <h3
            data-active-title
            class="font-sans text-2xl sm:text-3xl md:text-4xl font-black uppercase tracking-tight text-[#000000] leading-tight"
          >
            {firstRecipe.title}
          </h3>

          <!-- Active Video Recipe Description (Changes when video changes) -->
          <p
            data-active-summary
            class="text-sm sm:text-base text-[#000000] max-w-xl mx-auto leading-relaxed font-normal"
          >
            {firstRecipe.summary}
          </p>

          <!-- Action Buttons: "Ver receita" + Optional "Ver Vídeo com Som" -->
          <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
            <button
              type="button"
              data-open-active-recipe
              data-recipe-id={firstRecipe.id}
              class="btn-lacti btn-lacti-md btn-lacti-primary"
              aria-label={`Ver receita de ${firstRecipe.title}`}
            >
              <span class="btn-label">Ver receita</span>
              <span class="btn-icon icon-default" aria-hidden="true">
                <Icon name="book-open" size={18} />
              </span>
              <span class="btn-icon icon-confirmed" aria-hidden="true">
                <Icon name="check-circle" size={18} />
              </span>
            </button>

            <button
              type="button"
              data-open-active-fullscreen
              class="btn-lacti btn-lacti-md btn-lacti-secondary"
              aria-label="Assistir vídeo em ecrã inteiro com som"
            >
              <span class="btn-label">Ecrã Inteiro + Som</span>
              <span class="btn-icon icon-default" aria-hidden="true">
                <Icon name="volume-on" size={18} />
              </span>
              <span class="btn-icon icon-confirmed" aria-hidden="true">
                <Icon name="check-circle" size={18} />
              </span>
            </button>
          </div>

          <!-- 360° Pagination Dots -->
          <div
            class="flex items-center justify-center gap-2 pt-2 flex-wrap"
            data-carousel-dots
            aria-label="Indicadores de posição do carrossel 360"
          >
            {displayedRecipes.map((r, idx) => (
              <button
                type="button"
                data-carousel-dot={idx}
                aria-label={`Ir para vídeo ${idx + 1}: ${r.title}`}
                aria-current={idx === 0 ? 'true' : 'false'}
                class={`h-3 rounded-full border-2 border-[#169f38] transition-all duration-150 ${
                  idx === 0 ? 'w-8 bg-[#169f38]' : 'w-3 bg-[#ffffff]'
                }`}
              />
            ))}
          </div>
        </div>
      )
    }
  </div>

  <!-- ===================================================================== -->
  <!-- FULLSCREEN VIDEO REEL PLAYER OVERLAY (NO TEXT ON VIDEO + SOUND ON)    -->
  <!-- ===================================================================== -->
  <dialog
    id="lacti-fullscreen-reel-dialog"
    class="fixed inset-0 w-screen h-screen max-w-none max-h-none m-0 p-0 bg-[#ffffff] text-[#000000] z-50 backdrop:bg-[#ffffff]"
    aria-label="Vídeo da receita em ecrã inteiro com som"
  >
    <div
      id="lacti-fullscreen-stage"
      class="relative w-full h-full flex items-center justify-center bg-[#ffffff] overflow-hidden"
    >
      <!-- Pure Fullscreen Visual Reel Canvas/Media WITHOUT ANY TEXT OVERLAY -->
      <canvas
        id="lacti-reel-canvas"
        width="1080"
        height="1920"
        class="w-full h-full object-contain bg-[#ffffff]"
      ></canvas>

      <!-- Minimal Floating Hardware Controls in Top-Right Corner (Zero Recipe Text on Video) -->
      <div class="fixed top-6 right-6 z-50 flex items-center gap-3">
        <button
          type="button"
          id="lacti-reel-sound-toggle"
          class="btn-lacti btn-lacti-sm btn-lacti-primary"
          aria-label="Alternar som do vídeo"
        >
          <span class="btn-label" id="lacti-reel-sound-label">Som Ativo</span>
          <span class="btn-icon icon-default" aria-hidden="true">
            <Icon name="volume-on" size={18} />
          </span>
          <span class="btn-icon icon-confirmed" aria-hidden="true">
            <Icon name="check-circle" size={18} />
          </span>
        </button>

        <a
          id="lacti-reel-ig-link"
          href="https://www.instagram.com/reel/DHTj0rNo1n9/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-lacti btn-lacti-sm btn-lacti-secondary"
          aria-label="Abrir Reel oficial no Instagram da Lactimonte"
        >
          <span class="btn-label">Instagram Reel</span>
          <span class="btn-icon icon-default" aria-hidden="true">
            <Icon name="instagram" size={18} />
          </span>
          <span class="btn-icon icon-confirmed" aria-hidden="true">
            <Icon name="check-circle" size={18} />
          </span>
        </a>

        <button
          type="button"
          id="lacti-reel-close-btn"
          class="btn-lacti btn-lacti-sm btn-lacti-secondary"
          aria-label="Fechar ecrã inteiro"
        >
          <span class="btn-label">Sair</span>
          <span class="btn-icon icon-default" aria-hidden="true">
            <Icon name="close" size={18} />
          </span>
          <span class="btn-icon icon-confirmed" aria-hidden="true">
            <Icon name="check-circle" size={18} />
          </span>
        </button>
      </div>
    </div>
  </dialog>

  <!-- ===================================================================== -->
  <!-- RECIPE DETAIL MODAL (Triggered by the external "Ver receita" button)  -->
  <!-- ===================================================================== -->
  <dialog
    id="lacti-recipe-detail-dialog"
    class="w-full max-w-3xl rounded-[32px] border-2 border-[#169f38] bg-[#ffffff] text-[#000000] p-0 backdrop:bg-[#ffffff]/90"
    aria-labelledby="modal-recipe-title"
  >
    <div class="p-6 md:p-10">
      <div class="flex items-start justify-between gap-4 pb-6 border-b-2 border-[#169f38]">
        <div>
          <span
            id="modal-recipe-category"
            class="font-script text-2xl text-[#169f38] block"
          >
            Receita Tradicional Lactimonte
          </span>
          <h3
            id="modal-recipe-title"
            class="font-sans text-2xl md:text-4xl font-black uppercase tracking-tight text-[#000000]"
          >
            Nome da Receita
          </h3>
        </div>
        <button
          type="button"
          id="modal-recipe-close"
          class="btn-lacti btn-lacti-sm btn-lacti-secondary shrink-0"
          aria-label="Fechar janela da receita"
        >
          <span class="btn-label">Fechar</span>
          <span class="btn-icon icon-default" aria-hidden="true">
            <Icon name="close" size={18} />
          </span>
          <span class="btn-icon icon-confirmed" aria-hidden="true">
            <Icon name="check-circle" size={18} />
          </span>
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 py-6">
        <div class="md:col-span-5">
          <div class="rounded-[24px] overflow-hidden border-2 border-[#169f38] aspect-[4/5] bg-[#ffffff]">
            <img
              id="modal-recipe-image"
              src="/assets/imagem/receitas/bee988fb-a537-4036-a0af-bcfdbce5f6b6.jpg"
              alt=""
              class="w-full h-full object-cover"
            />
          </div>
          <div class="mt-4 p-4 rounded-[20px] border-2 border-[#169f38] bg-[#ffffff] space-y-2 text-sm text-[#000000]">
            <div class="flex justify-between">
              <span class="font-bold text-[#169f38]">Queijo Lactimonte:</span>
              <span id="modal-recipe-cheese" class="font-bold text-right"></span>
            </div>
            <div class="flex justify-between">
              <span class="font-bold text-[#169f38]">Tempo:</span>
              <span id="modal-recipe-time" class="font-bold"></span>
            </div>
            <div class="flex justify-between">
              <span class="font-bold text-[#169f38]">Doses:</span>
              <span id="modal-recipe-servings" class="font-bold"></span>
            </div>
          </div>
        </div>

        <div class="md:col-span-7 space-y-6 text-[#000000]">
          <p id="modal-recipe-summary" class="text-base font-normal leading-relaxed"></p>

          <div>
            <h4 class="font-sans text-lg font-black uppercase tracking-wider text-[#169f38] border-b-2 border-[#169f38] pb-2 mb-3">
              Ingredientes
            </h4>
            <ul id="modal-recipe-ingredients" class="space-y-2 text-sm font-medium list-disc pl-5"></ul>
          </div>

          <div>
            <h4 class="font-sans text-lg font-black uppercase tracking-wider text-[#169f38] border-b-2 border-[#169f38] pb-2 mb-3">
              Preparação Passo a Passo
            </h4>
            <ol id="modal-recipe-steps" class="space-y-3 text-sm font-medium list-decimal pl-5"></ol>
          </div>
        </div>
      </div>
    </div>
  </dialog>

  <!-- Embedded JSON Data for Instant Client-Side Recipe Modal & 360° Carousel Hydration -->
  <script
    type="application/json"
    data-recipes-json
    set:html={JSON.stringify(displayedRecipes)}
  />
</section>

<script>
  interface RecipeData {
    id: string;
    title: string;
    category: string;
    cheeseUsed: string;
    prepTime: string;
    servings: string;
    difficulty: string;
    image: string;
    videoDuration: string;
    instagramReelUrl?: string;
    summary: string;
    ingredients: string[];
    steps: string[];
  }

  function initVideoReelSections() {
    const sections = document.querySelectorAll<HTMLElement>('[data-videoreel-section]');

    sections.forEach((section) => {
      if (section.dataset.initialized === 'true') return;
      section.dataset.initialized = 'true';

      const dataEl = section.querySelector<HTMLScriptElement>('[data-recipes-json]');
      if (!dataEl) return;
      const allRecipes: RecipeData[] = JSON.parse(dataEl.textContent || '[]');
      if (!allRecipes.length) return;

      const carouselRoot = section.querySelector<HTMLElement>('[data-carousel-root]');
      const stage = section.querySelector<HTMLElement>('[data-carousel-stage]');
      const allCards = Array.from(section.querySelectorAll<HTMLElement>('[data-carousel-card]'));
      const prevBtn = section.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const nextBtn = section.querySelector<HTMLButtonElement>('[data-carousel-next]');
      const dotsContainer = section.querySelector<HTMLElement>('[data-carousel-dots]');

      // Bottom dynamic text panel elements (outside the video image)
      const counterEl = section.querySelector<HTMLElement>('[data-active-counter]');
      const cheeseEl = section.querySelector<HTMLElement>('[data-active-cheese]');
      const metaEl = section.querySelector<HTMLElement>('[data-active-meta] span');
      const titleEl = section.querySelector<HTMLElement>('[data-active-title]');
      const summaryEl = section.querySelector<HTMLElement>('[data-active-summary]');
      const openRecipeBtn = section.querySelector<HTMLButtonElement>('[data-open-active-recipe]');
      const openFsBtn = section.querySelector<HTMLButtonElement>('[data-open-active-fullscreen]');

      // Modals
      const recipeDialog = section.querySelector<HTMLDialogElement>('#lacti-recipe-detail-dialog');
      const closeRecipeBtn = section.querySelector<HTMLElement>('#modal-recipe-close');
      const fsDialog = section.querySelector<HTMLDialogElement>('#lacti-fullscreen-reel-dialog');
      const fsStage = section.querySelector<HTMLElement>('#lacti-fullscreen-stage');
      const fsCanvas = section.querySelector<HTMLCanvasElement>('#lacti-reel-canvas');
      const fsCloseBtn = section.querySelector<HTMLElement>('#lacti-reel-close-btn');
      const fsSoundToggle = section.querySelector<HTMLElement>('#lacti-reel-sound-toggle');
      const fsSoundLabel = section.querySelector<HTMLElement>('#lacti-reel-sound-label');
      const fsIgLink = section.querySelector<HTMLAnchorElement>('#lacti-reel-ig-link');

      // Active state for 360° carousel
      let activeCards: HTMLElement[] = [...allCards];
      let activeIndex = 0; // Index within activeCards

      // Helper: positive modulo for 360° wrap-around
      function mod(n: number, m: number): number {
        return ((n % m) + m) % m;
      }

      // Shortest signed circular distance on a 360° ring of length total
      function getCircularOffset(cardIdx: number, virtualCenter: number, total: number): number {
        let diff = cardIdx - virtualCenter;
        diff = ((diff + total / 2) % total + total) % total - total / 2;
        return diff;
      }

      // Compute 3D coverflow transform matching https://videoreelpro.framer.website/
      function applyCardTransform(card: HTMLElement, offset: number) {
        const abs = Math.abs(offset);
        const sign = offset < 0 ? -1 : 1;

        // Piecewise interpolation for smooth 360° dragging & coverflow stacking:
        // offset 0   -> translateX: 0%,   scale: 1.00, opacity: 1.00
        // offset ±1  -> translateX: ±48%, scale: 0.86, opacity: 0.90
        // offset ±2  -> translateX: ±86%, scale: 0.73, opacity: 0.65
        // offset >2  -> translateX: ±105%, scale: 0.60, opacity: 0.00
        let tx = 0;
        let scale = 1;
        let opacity = 1;

        if (abs <= 1) {
          tx = offset * 48;
          scale = 1 - abs * 0.14;
          opacity = 1 - abs * 0.1;
        } else if (abs <= 2) {
          const t = abs - 1;
          tx = sign * (48 + t * 38);
          scale = 0.86 - t * 0.13;
          opacity = 0.9 - t * 0.25;
        } else {
          const t = Math.min(abs - 2, 1);
          tx = sign * (86 + t * 22);
          scale = 0.73 - t * 0.15;
          opacity = Math.max(0, 0.65 * (1 - t * 1.35));
        }

        const zIndex = Math.max(1, Math.round(30 - abs * 10));

        card.style.transform = `translate3d(${tx}%, 0, 0) scale(${scale})`;
        card.style.opacity = `${opacity}`;
        card.style.zIndex = `${zIndex}`;
        card.style.pointerEvents = abs <= 2.2 ? 'auto' : 'none';
        card.setAttribute('data-active', abs < 0.45 ? 'true' : 'false');
      }

      function updateBottomPanel(recipe: RecipeData, currentIdx: number, totalCount: number) {
        if (counterEl) {
          counterEl.textContent = `${currentIdx + 1} / ${totalCount}`;
        }
        if (cheeseEl) {
          cheeseEl.textContent = recipe.cheeseUsed;
        }
        if (metaEl) {
          metaEl.textContent = `${recipe.prepTime} • ${recipe.difficulty}`;
        }
        if (titleEl) {
          titleEl.textContent = recipe.title;
        }
        if (summaryEl) {
          summaryEl.textContent = recipe.summary;
        }
        if (openRecipeBtn) {
          openRecipeBtn.setAttribute('data-recipe-id', recipe.id);
          openRecipeBtn.setAttribute('aria-label', `Ver receita de ${recipe.title}`);
        }

        // Update pagination dots
        if (dotsContainer) {
          const dots = dotsContainer.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]');
          dots.forEach((dot, idx) => {
            const isCurrent = idx === currentIdx;
            dot.setAttribute('aria-current', isCurrent ? 'true' : 'false');
            dot.classList.toggle('w-8', isCurrent);
            dot.classList.toggle('bg-[#169f38]', isCurrent);
            dot.classList.toggle('w-3', !isCurrent);
            dot.classList.toggle('bg-[#ffffff]', !isCurrent);
          });
        }
      }

      function renderCarousel(virtualCenter: number) {
        const total = activeCards.length;
        if (total === 0) return;

        // Hide cards excluded by category filter
        allCards.forEach((card) => {
          if (!activeCards.includes(card)) {
            card.style.opacity = '0';
            card.style.pointerEvents = 'none';
            card.style.zIndex = '0';
            card.style.transform = 'translate3d(0, 0, 0) scale(0.5)';
            card.setAttribute('data-active', 'false');
          }
        });

        activeCards.forEach((card, idx) => {
          const offset = getCircularOffset(idx, virtualCenter, total);
          applyCardTransform(card, offset);
        });

        const nearestIdx = mod(Math.round(virtualCenter), total);
        const activeCard = activeCards[nearestIdx];
        const recipeId = activeCard?.getAttribute('data-recipe-id');
        const recipe = allRecipes.find((r) => r.id === recipeId) || allRecipes[0];
        if (recipe) {
          updateBottomPanel(recipe, nearestIdx, total);
        }
      }

      function goToIndex(newIndex: number) {
        if (!activeCards.length) return;
        activeIndex = mod(newIndex, activeCards.length);
        renderCarousel(activeIndex);
      }

      function rebuildDots() {
        if (!dotsContainer) return;
        const fragment = document.createDocumentFragment();
        activeCards.forEach((card, idx) => {
          const recipeId = card.getAttribute('data-recipe-id');
          const recipe = allRecipes.find((r) => r.id === recipeId);
          const isCurrent = idx === activeIndex;
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.setAttribute('data-carousel-dot', String(idx));
          dot.setAttribute('aria-label', `Ir para vídeo ${idx + 1}: ${recipe?.title || ''}`);
          dot.setAttribute('aria-current', isCurrent ? 'true' : 'false');
          dot.className = `h-3 rounded-full border-2 border-[#169f38] transition-all duration-150 ${
            isCurrent ? 'w-8 bg-[#169f38]' : 'w-3 bg-[#ffffff]'
          }`;
          dot.addEventListener('click', () => {
            goToIndex(idx);
          });
          fragment.appendChild(dot);
        });
        dotsContainer.replaceChildren(fragment);
      }

      // Initial render
      rebuildDots();
      renderCarousel(0);

      // Left & Right Arrow Buttons (Positioned on Left and Right sides)
      prevBtn?.addEventListener('click', () => {
        goToIndex(activeIndex - 1);
      });

      nextBtn?.addEventListener('click', () => {
        goToIndex(activeIndex + 1);
      });

      // Keyboard Left / Right Arrows support
      carouselRoot?.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          goToIndex(activeIndex - 1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          goToIndex(activeIndex + 1);
        }
      });

      // Mouse & Touch Dragging (Open hand 'grab' -> Closed hand 'grabbing' when dragging)
      let isDragging = false;
      let startX = 0;
      let deltaX = 0;
      let pointerDownCard: HTMLElement | null = null;

      if (stage) {
        stage.addEventListener('pointerdown', (e: PointerEvent) => {
          if (e.button !== 0 && e.pointerType === 'mouse') return;
          isDragging = true;
          startX = e.clientX;
          deltaX = 0;
          pointerDownCard = (e.target as HTMLElement).closest<HTMLElement>('[data-carousel-card]');
          stage.classList.add('is-dragging');
          stage.setPointerCapture(e.pointerId);
        });

        stage.addEventListener('pointermove', (e: PointerEvent) => {
          if (!isDragging || !activeCards.length) return;
          deltaX = e.clientX - startX;
          // Dragging right (positive deltaX) moves carousel to previous item; dragging left moves to next item
          const dragItemsOffset = -deltaX / 210;
          renderCarousel(activeIndex + dragItemsOffset);
        });

        const endDrag = (e: PointerEvent) => {
          if (!isDragging) return;
          isDragging = false;
          stage.classList.remove('is-dragging');
          if (stage.hasPointerCapture(e.pointerId)) {
            stage.releasePointerCapture(e.pointerId);
          }

          // Check if it was a click without dragging
          if (Math.abs(deltaX) < 8) {
            if (pointerDownCard && activeCards.includes(pointerDownCard)) {
              const clickedIdx = activeCards.indexOf(pointerDownCard);
              if (clickedIdx !== activeIndex) {
                // Clicking a side card brings it to the center of the 360° carousel
                goToIndex(clickedIdx);
                return;
              } else {
                // Clicking the active center card opens Fullscreen Video Reel with sound
                const recipeId = pointerDownCard.getAttribute('data-recipe-id');
                const recipe = allRecipes.find((r) => r.id === recipeId);
                if (recipe) openFullscreenReel(recipe);
                return;
              }
            }
          }

          // Snap after drag
          const dragItemsOffset = -deltaX / 210;
          if (Math.abs(deltaX) > 38 && Math.abs(dragItemsOffset) < 0.5) {
            goToIndex(activeIndex + (deltaX < 0 ? 1 : -1));
          } else {
            goToIndex(Math.round(activeIndex + dragItemsOffset));
          }
        };

        stage.addEventListener('pointerup', endDrag);
        stage.addEventListener('pointercancel', endDrag);
      }

      // Category Filter Tabs
      const filterButtons = section.querySelectorAll<HTMLButtonElement>('[data-recipe-filter]');
      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const selectedCat = btn.getAttribute('data-recipe-filter') || 'Todas';

          filterButtons.forEach((b) => {
            const isCurrent = b === btn;
            b.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
            b.classList.toggle('btn-lacti-primary', isCurrent);
            b.classList.toggle('btn-lacti-secondary', !isCurrent);
          });

          activeCards = allCards.filter((card) => {
            const itemCat = card.getAttribute('data-recipe-category');
            return selectedCat === 'Todas' || itemCat === selectedCat;
          });

          activeIndex = 0;
          rebuildDots();
          renderCarousel(0);
        });
      });

      // Recipe Detail Modal ("Ver receita" button below the carousel)
      function openRecipeModalById(recipeId: string) {
        const recipe = allRecipes.find((r) => r.id === recipeId);
        if (!recipe || !recipeDialog) return;

        const mTitle = recipeDialog.querySelector<HTMLElement>('#modal-recipe-title');
        const mCat = recipeDialog.querySelector<HTMLElement>('#modal-recipe-category');
        const mImg = recipeDialog.querySelector<HTMLImageElement>('#modal-recipe-image');
        const mCheese = recipeDialog.querySelector<HTMLElement>('#modal-recipe-cheese');
        const mTime = recipeDialog.querySelector<HTMLElement>('#modal-recipe-time');
        const mServings = recipeDialog.querySelector<HTMLElement>('#modal-recipe-servings');
        const mSummary = recipeDialog.querySelector<HTMLElement>('#modal-recipe-summary');
        const mIng = recipeDialog.querySelector<HTMLElement>('#modal-recipe-ingredients');
        const mSteps = recipeDialog.querySelector<HTMLElement>('#modal-recipe-steps');

        if (mTitle) mTitle.textContent = recipe.title;
        if (mCat) mCat.textContent = recipe.category;
        if (mImg) {
          mImg.src = recipe.image;
          mImg.alt = recipe.title;
        }
        if (mCheese) mCheese.textContent = recipe.cheeseUsed;
        if (mTime) mTime.textContent = recipe.prepTime;
        if (mServings) mServings.textContent = recipe.servings;
        if (mSummary) mSummary.textContent = recipe.summary;

        if (mIng) {
          const ingNodes = recipe.ingredients.map((ing) => {
            const li = document.createElement('li');
            li.textContent = ing;
            return li;
          });
          mIng.replaceChildren(...ingNodes);
        }
        if (mSteps) {
          const stepNodes = recipe.steps.map((step) => {
            const li = document.createElement('li');
            li.textContent = step;
            return li;
          });
          mSteps.replaceChildren(...stepNodes);
        }

        recipeDialog.showModal();
      }

      openRecipeBtn?.addEventListener('click', () => {
        const recipeId = openRecipeBtn.getAttribute('data-recipe-id');
        if (recipeId) openRecipeModalById(recipeId);
      });

      closeRecipeBtn?.addEventListener('click', () => {
        recipeDialog?.close();
      });

      recipeDialog?.addEventListener('click', (e) => {
        if (e.target === recipeDialog) recipeDialog.close();
      });

      // Fullscreen Video Reel Mode (WITHOUT text overlay on video + WITH sound)
      let animFrameId: number | null = null;
      let audioCtx: AudioContext | null = null;
      let gainNode: GainNode | null = null;
      let isSoundActive = true;

      function startAmbientAudio() {
        try {
          const AudioContextClass =
            window.AudioContext ||
            (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
          if (!AudioContextClass) return;
          audioCtx = new AudioContextClass();
          gainNode = audioCtx.createGain();
          gainNode.gain.setValueAtTime(0.06, audioCtx.currentTime);
          gainNode.connect(audioCtx.destination);

          const freqs = [261.63, 329.63, 392.0, 587.33];
          freqs.forEach((f) => {
            if (!audioCtx || !gainNode) return;
            const osc = audioCtx.createOscillator();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(f, audioCtx.currentTime);
            osc.connect(gainNode);
            osc.start();
          });
          isSoundActive = true;
          if (fsSoundLabel) fsSoundLabel.textContent = 'Som Ativo';
        } catch {
          // Ignore if browser blocks audio context
        }
      }

      function stopAmbientAudio() {
        if (audioCtx) {
          audioCtx.close().catch(() => {});
          audioCtx = null;
          gainNode = null;
        }
      }

      function startCanvasReelAnimation(imageUrl: string) {
        if (!fsCanvas) return;
        const ctx = fsCanvas.getContext('2d');
        if (!ctx) return;

        const img = new Image();
        img.src = imageUrl;
        const startTime = performance.now();

        img.onload = () => {
          const render = (now: number) => {
            const elapsed = (now - startTime) / 1000;
            const scale = 1.04 + Math.sin(elapsed * 0.6) * 0.04;
            const panX = Math.cos(elapsed * 0.4) * 20;
            const panY = Math.sin(elapsed * 0.5) * 20;

            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, fsCanvas.width, fsCanvas.height);

            const imgRatio = img.width / img.height;
            const canvasRatio = fsCanvas.width / fsCanvas.height;
            let drawW = fsCanvas.width;
            let drawH = fsCanvas.height;

            if (imgRatio > canvasRatio) {
              drawH = fsCanvas.height * scale;
              drawW = drawH * imgRatio;
            } else {
              drawW = fsCanvas.width * scale;
              drawH = drawW / imgRatio;
            }

            const offsetX = (fsCanvas.width - drawW) / 2 + panX;
            const offsetY = (fsCanvas.height - drawH) / 2 + panY;

            // Pure visual frame — ZERO text drawn on the fullscreen video!
            ctx.drawImage(img, offsetX, offsetY, drawW, drawH);

            // Progress bar at very bottom edge (green line)
            const progress = (elapsed % 12) / 12;
            ctx.fillStyle = '#169f38';
            ctx.fillRect(0, fsCanvas.height - 6, fsCanvas.width * progress, 6);

            animFrameId = requestAnimationFrame(render);
          };
          animFrameId = requestAnimationFrame(render);
        };
      }

      function getSafeHttpsUrl(rawUrl: string | undefined, fallback: string): string {
        if (!rawUrl) return fallback;
        try {
          const parsed = new URL(rawUrl);
          return parsed.protocol === 'https:' ? parsed.toString() : fallback;
        } catch {
          return fallback;
        }
      }

      function openFullscreenReel(recipe: RecipeData) {
        if (fsIgLink) {
          fsIgLink.href = getSafeHttpsUrl(
            recipe.instagramReelUrl,
            'https://www.instagram.com/reel/DHTj0rNo1n9/'
          );
          fsIgLink.rel = 'noopener noreferrer';
        }
        fsDialog?.showModal();
        startCanvasReelAnimation(recipe.image);
        startAmbientAudio();

        if (fsStage && fsStage.requestFullscreen) {
          fsStage.requestFullscreen().catch(() => {});
        }
      }

      function closeFullscreenReel() {
        if (animFrameId) {
          cancelAnimationFrame(animFrameId);
          animFrameId = null;
        }
        stopAmbientAudio();
        if (document.fullscreenElement) {
          document.exitFullscreen().catch(() => {});
        }
        fsDialog?.close();
      }

      openFsBtn?.addEventListener('click', () => {
        const activeCard = activeCards[activeIndex];
        const recipeId = activeCard?.getAttribute('data-recipe-id');
        const recipe = allRecipes.find((r) => r.id === recipeId) || allRecipes[0];
        if (recipe) openFullscreenReel(recipe);
      });

      fsSoundToggle?.addEventListener('click', () => {
        if (!audioCtx || !gainNode) {
          startAmbientAudio();
          return;
        }
        isSoundActive = !isSoundActive;
        gainNode.gain.setValueAtTime(isSoundActive ? 0.06 : 0, audioCtx.currentTime);
        if (fsSoundLabel) {
          fsSoundLabel.textContent = isSoundActive ? 'Som Ativo' : 'Sem Som';
        }
      });

      fsCloseBtn?.addEventListener('click', closeFullscreenReel);
      fsDialog?.addEventListener('close', closeFullscreenReel);
    });
  }

  initVideoReelSections();
  document.addEventListener('astro:after-swap', initVideoReelSections);
</script>
