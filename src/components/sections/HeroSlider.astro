---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface SlideData {
  id: string;
  number: string;
  phrase: string;
  title: string;
  titleHighlight?: string;
  buttonLabel: string;
  buttonHref: string;
  bgImage: string;
}

const slides: SlideData[] = [
  {
    id: 'slide-1',
    number: '01',
    phrase: 'Da Nossa Queijaria para a Sua Mesa',
    title: 'Três Especialidades.',
    titleHighlight: 'Uma Tradição Saloia',
    buttonLabel: 'Explorar Os Nossos Queijos',
    buttonHref: '/queijos',
    bgImage: '/assets/imagem/slide_hero/hero-bg-slide1.jpg',
  },
  {
    id: 'slide-2',
    number: '02',
    phrase: 'A Arte Queijeira desde 1980',
    title: 'Mais de 40 Anos',
    titleHighlight: 'de História & Tradição',
    buttonLabel: 'Conhecer a Lactimonte',
    buttonHref: '/a-lactimonte',
    bgImage: '/assets/imagem/slide_hero/hero-bg-slide2.jpg',
  },
  {
    id: 'slide-3',
    number: '03',
    phrase: 'Da Queijaria para a Sua Cozinha',
    title: 'Receitas',
    titleHighlight: 'Lactimonte',
    buttonLabel: 'Descobrir Receitas',
    buttonHref: '/receitas',
    bgImage: '/assets/imagem/slide_hero/hero-bg-slide3.jpg',
  },
];
---

<section
  id="hero-interactive-carousel"
  class="group relative w-full overflow-hidden bg-[#0a3318] text-[#ffffff] select-none"
  aria-label="Carrossel Principal Lactimonte"
  role="region"
  aria-roledescription="carousel"
>
  <!-- Continuous Horizontal Slider Track Viewport -->
  <div class="relative w-full overflow-hidden">
    <div
      id="hero-slider-track"
      class="flex w-full will-change-transform transition-transform duration-700 ease-[cubic-bezier(0.25,1,0.5,1)]"
      style="transform: translateX(0%);"
    >
      {
        slides.map((slide, idx) => (
          <article
            class="hero-slide w-full flex-shrink-0 min-w-full relative min-h-[640px] sm:min-h-[685px] md:min-h-[730px] lg:min-h-[775px] xl:min-h-[820px] flex items-center overflow-hidden"
            data-slide-index={idx}
            aria-hidden={idx === 0 ? 'false' : 'true'}
          >
            <!-- 1920x1080 High-Resolution Background Image (Wall illusion for Slide 1, Studio green for Slide 2 & 3) -->
            <img
              src={slide.bgImage}
              alt=""
              width="1920"
              height="1080"
              class="absolute inset-0 w-full h-full object-cover pointer-events-none select-none"
              loading={idx === 0 ? 'eager' : 'lazy'}
              fetchpriority={idx === 0 ? 'high' : 'auto'}
            />

            <!-- Slide Content (Lacti Container) -->
            <div class="lacti-container relative z-10 py-20 sm:py-24 lg:py-32 pb-36 sm:pb-40 lg:pb-44 w-full">
              <div class="max-w-3xl sm:max-w-4xl space-y-5 sm:space-y-7 text-left">
                <!-- Script Subtitle in strict #169f38 -->
                <span class="hero-slide-phrase font-script text-3xl sm:text-4xl md:text-5xl text-[#169f38] block transition-transform duration-500">
                  {slide.phrase}
                </span>

                <!-- Display Heading: White with #169f38 highlight -->
                <h1 class="hero-slide-title font-sans text-4xl sm:text-5xl md:text-6xl xl:text-7xl font-black uppercase tracking-tight leading-[1.05] text-[#ffffff]">
                  {slide.title}{' '}
                  {slide.titleHighlight && (
                    <span class="text-[#169f38] block sm:inline">
                      {slide.titleHighlight}
                    </span>
                  )}
                </h1>

                <!-- CTA Button (Variação 3 — Slide) -->
                <div class="hero-slide-btn pt-3 sm:pt-4 flex items-center gap-4">
                  <Button
                    href={slide.buttonHref}
                    variant="slide"
                    size="lg"
                    icon="arrow-up-right"
                    label={slide.buttonLabel}
                  />
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <!-- ======================================================================= -->
  <!-- BOTTOM WHITE MILK WAVE SPLASH                                           -->
  <!-- ======================================================================= -->
  <div class="absolute -bottom-1 left-0 right-0 w-full pointer-events-none z-20 overflow-hidden leading-none">
    <svg
      class="w-full h-16 sm:h-20 md:h-24 lg:h-28 text-[#ffffff] fill-current"
      viewBox="0 0 1440 120"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <!-- Foreground fluid milk wave -->
      <path
        d="M0,65 C120,95 240,45 370,75 C500,105 640,40 780,72 C920,104 1060,42 1200,68 C1320,88 1390,55 1440,62 L1440,120 L0,120 Z"
        fill="#ffffff"
      ></path>
    </svg>
  </div>

  <!-- ======================================================================= -->
  <!-- SIDE NAVIGATION ARROWS (Pure arrows without circles/borders)            -->
  <!-- ======================================================================= -->
  <!-- Left Arrow Button -->
  <button
    id="hero-slider-prev-btn"
    type="button"
    aria-label="Slide anterior"
    class="absolute left-3 sm:left-6 md:left-10 top-1/2 -translate-y-1/2 z-30 p-2 text-white/80 hover:text-white hover:scale-110 transition-all duration-300 cursor-pointer opacity-100 lg:opacity-0 lg:group-hover:opacity-100 focus-visible:opacity-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#86efac]"
  >
    <Icon name="chevron-left" size={38} />
  </button>

  <!-- Right Arrow Button -->
  <button
    id="hero-slider-next-btn"
    type="button"
    aria-label="Próximo slide"
    class="absolute right-3 sm:right-6 md:right-10 top-1/2 -translate-y-1/2 z-30 p-2 text-white/80 hover:text-white hover:scale-110 transition-all duration-300 cursor-pointer opacity-100 lg:opacity-0 lg:group-hover:opacity-100 focus-visible:opacity-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#86efac]"
  >
    <Icon name="chevron-right" size={38} />
  </button>

  <!-- ======================================================================= -->
  <!-- PAGINATION DOTS (Small isolated dots placed higher inside the slide)    -->
  <!-- ======================================================================= -->
  <div class="absolute bottom-20 sm:bottom-24 md:bottom-28 lg:bottom-32 left-1/2 -translate-x-1/2 z-30 flex items-center justify-center pointer-events-auto">
    <div class="flex items-center gap-2.5 sm:gap-3" role="tablist" aria-label="Navegação de slides">
      {
        slides.map((slide, idx) => (
          <button
            type="button"
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
            aria-label={`Ir para o slide ${idx + 1}: ${slide.title}`}
            data-target-slide={idx}
            class="hero-dot-btn p-1 transition-transform duration-200 hover:scale-125 cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#169f38]"
          >
            <span
              class={`hero-dot block rounded-full transition-all duration-300 ${
                idx === 0
                  ? 'w-2.5 h-2.5 sm:w-3 sm:h-3 bg-[#169f38] shadow-sm active-dot'
                  : 'w-2 h-2 sm:w-2.5 sm:h-2.5 bg-[#ffffff] opacity-75 hover:opacity-100'
              }`}
            />
          </button>
        ))
      }
    </div>
  </div>
</section>

<script>
  function initHeroCarousel() {
    const carousel = document.getElementById('hero-interactive-carousel');
    const track = document.getElementById('hero-slider-track') as HTMLElement | null;
    if (!carousel || !track) return;

    const slides = track.querySelectorAll<HTMLElement>('.hero-slide');
    const prevBtn = document.getElementById('hero-slider-prev-btn');
    const nextBtn = document.getElementById('hero-slider-next-btn');
    const dotButtons = carousel.querySelectorAll<HTMLButtonElement>('.hero-dot-btn');

    if (slides.length === 0) return;

    let currentSlide = 0;
    const totalSlides = slides.length;
    let autoplayTimer: number | null = null;

    function goToSlide(newIndex: number) {
      if (newIndex === currentSlide) return;

      // Continuous horizontal slider movement:
      // When jumping from slide 0 to 2, track translates from 0% to -200%, passing through slide 1 in the middle!
      // When moving from 2 to 0, track translates from -200% to 0%, passing back through slide 1!
      track.style.transform = `translateX(-${newIndex * 100}%)`;

      slides.forEach((slide, idx) => {
        slide.setAttribute('aria-hidden', idx === newIndex ? 'false' : 'true');
      });

      // Update Pagination Dots (Verde para o ativo, Brancas para os outros)
      dotButtons.forEach((btn, idx) => {
        const dot = btn.querySelector('.hero-dot');
        if (!dot) return;

        if (idx === newIndex) {
          btn.setAttribute('aria-selected', 'true');
          dot.classList.remove('bg-[#ffffff]', 'opacity-75', 'w-2', 'h-2', 'sm:w-2.5', 'sm:h-2.5');
          dot.classList.add('bg-[#169f38]', 'w-2.5', 'h-2.5', 'sm:w-3', 'sm:h-3', 'active-dot');
        } else {
          btn.setAttribute('aria-selected', 'false');
          dot.classList.remove('bg-[#169f38]', 'w-2.5', 'h-2.5', 'sm:w-3', 'sm:h-3', 'active-dot');
          dot.classList.add('bg-[#ffffff]', 'opacity-75', 'w-2', 'h-2', 'sm:w-2.5', 'sm:h-2.5');
        }
      });

      currentSlide = newIndex;
    }

    function nextSlide() {
      const target = (currentSlide + 1) % totalSlides;
      goToSlide(target);
    }

    function prevSlide() {
      const target = (currentSlide - 1 + totalSlides) % totalSlides;
      goToSlide(target);
    }

    // Direct Pagination Dot Clicking
    dotButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetIdx = Number(btn.getAttribute('data-target-slide'));
        if (!isNaN(targetIdx)) {
          goToSlide(targetIdx);
          restartAutoplay();
        }
      });
    });

    // Arrow Buttons (Next / Prev)
    nextBtn?.addEventListener('click', () => {
      nextSlide();
      restartAutoplay();
    });

    prevBtn?.addEventListener('click', () => {
      prevSlide();
      restartAutoplay();
    });

    // Keyboard navigation (ArrowLeft & ArrowRight)
    carousel.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        nextSlide();
        restartAutoplay();
      } else if (e.key === 'ArrowLeft') {
        prevSlide();
        restartAutoplay();
      }
    });

    // Touch Swiping support
    let touchStartX = 0;
    let touchEndX = 0;
    carousel.addEventListener(
      'touchstart',
      (e) => {
        touchStartX = e.changedTouches[0].screenX;
      },
      { passive: true }
    );
    carousel.addEventListener(
      'touchend',
      (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const diff = touchEndX - touchStartX;
        if (Math.abs(diff) > 40) {
          if (diff < 0) {
            nextSlide();
          } else {
            prevSlide();
          }
          restartAutoplay();
        }
      },
      { passive: true }
    );

    // Subtle Auto-play with pause on hover/focus (WCAG 2.2 compliant)
    function startAutoplay() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      stopAutoplay();
      autoplayTimer = window.setInterval(nextSlide, 7500);
    }

    function stopAutoplay() {
      if (autoplayTimer !== null) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    function restartAutoplay() {
      stopAutoplay();
      startAutoplay();
    }

    carousel.addEventListener('mouseenter', stopAutoplay);
    carousel.addEventListener('mouseleave', startAutoplay);
    carousel.addEventListener('focusin', stopAutoplay);
    carousel.addEventListener('focusout', startAutoplay);

    startAutoplay();
  }

  initHeroCarousel();
  document.addEventListener('astro:page-load', initHeroCarousel);
</script>
