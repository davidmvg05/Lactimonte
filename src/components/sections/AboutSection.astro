---
import Button from '../ui/Button.astro';

interface CarouselSlide {
  id: string;
  src: string;
  alt: string;
  tag: string;
}

const slides: CarouselSlide[] = [
  {
    id: 'fabrico',
    src: '/assets/imagem/carrosel_imagem/lactimonte-tradicao-fabrico.jpg',
    alt: 'Mestria queijeira tradicional na produção de queijo',
    tag: 'Arte Queijeira',
  },
  {
    id: 'maturacao',
    src: '/assets/imagem/carrosel_imagem/lactimonte-cave-maturacao.jpg',
    alt: 'Cave de cura e maturação de queijos tradicionais',
    tag: 'Cura & Maturação',
  },
  {
    id: 'pastagens',
    src: '/assets/imagem/carrosel_imagem/lactimonte-pastagens-mafra.jpg',
    alt: 'Pastagens verdes e rebanhos da Região Saloia em Mafra',
    tag: 'Terroir Saloio',
  },
  {
    id: 'degustacao',
    src: '/assets/imagem/carrosel_imagem/lactimonte-mesa-degustacao.jpg',
    alt: 'Mesa de degustação com queijo curado, pão de Mafra e mel',
    tag: 'Mesa Portuguesa',
  },
  {
    id: 'rebanhos',
    src: '/assets/imagem/carrosel_imagem/lactimonte-rebanhos-campo.jpg',
    alt: 'Rebanhos pastando livremente nos campos de Mafra',
    tag: 'Pastoreio Livre',
  },
];
---

<section
  id="sobre-nos-lactimonte"
  class="relative py-20 sm:py-28 md:py-32 bg-[#ffffff] text-[#1e1e1e] overflow-hidden select-none"
  aria-label="Sobre a Lactimonte - Tradição e Sustentabilidade"
>
  <div class="w-full pl-6 sm:pl-10 md:pl-16 lg:pl-20 xl:pl-28 pr-0">
    <!-- Grid centralizada verticalmente: Esquerda (Texto) | Centro (Foto Principal) | Direita (Fotos Seguintes) -->
    <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-14 xl:gap-16 w-full">
      
      <!-- COLUNA 1 (ESQUERDA): TEXTOS E BOTÃO -->
      <div class="w-full lg:w-[32%] xl:w-[30%] flex-shrink-0 flex flex-col justify-center space-y-4 sm:space-y-5">
        <!-- Frase Dancing Script em Verde -->
        <p class="font-script text-2xl sm:text-3xl text-[#169f38] leading-tight">
          Montemuro · Santo Estevão das Galés · Mafra
        </p>

        <!-- Título Principal em Roboto -->
        <h2 class="font-sans text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-[#1e1e1e] leading-[1.12]">
          <span class="block">Mais de 45 anos</span>
          <span class="block">de rigor frescura</span>
          <span class="block">e sustentabilidade</span>
        </h2>

        <!-- Botão Variação 1 (Primário) Verde -->
        <div class="pt-2">
          <Button
            href="/marca"
            variant="primary"
            size="md"
            ariaLabel="Saber mais sobre a história e valores da Lactimonte"
          >
            Lacti+
          </Button>
        </div>
      </div>

      <!-- COLUNA 2 (CENTRO): FOTO PRINCIPAL QUADRADA COM A SETA PRETA GROSSA (CONFORME IMAGENS 1 E 2) -->
      <div class="w-full sm:w-[420px] md:w-[460px] lg:w-[430px] xl:w-[480px] flex-shrink-0 relative">
        <div
          id="featured-image-card"
          class="relative w-full aspect-square rounded-2xl sm:rounded-3xl overflow-visible shadow-[0_16px_40px_-8px_rgba(0,0,0,0.18)] bg-[#f3f4f6]"
        >
          <!-- Imagem Principal Ativa com Cantos Arredondados -->
          <div class="w-full h-full overflow-hidden rounded-2xl sm:rounded-3xl">
            <img
              id="featured-main-img"
              src={slides[0].src}
              alt={slides[0].alt}
              class="w-full h-full object-cover select-none transition-opacity duration-300"
              loading="eager"
            />
          </div>

          <!-- Tag em Caixa Alta no Canto Superior Esquerdo -->
          <div class="absolute top-5 left-5 sm:top-6 sm:left-6 z-20 pointer-events-none">
            <span
              id="featured-main-tag"
              class="font-sans text-xs sm:text-sm uppercase font-bold tracking-widest text-[#ffffff] drop-shadow-[0_2px_4px_rgba(0,0,0,0.85)]"
            >
              {slides[0].tag}
            </span>
          </div>

          <!-- Gradiente sutil superior para legibilidade da tag com cantos arredondados -->
          <div class="absolute inset-x-0 top-0 h-20 bg-gradient-to-b from-black/50 to-transparent pointer-events-none rounded-t-2xl sm:rounded-t-3xl"></div>

          <!-- Seta Chevron Preta (sem hover, estável e nítida) -->
          <button
            id="about-slider-next-btn"
            type="button"
            class="absolute -right-3 sm:-right-4 top-1/2 -translate-y-1/2 translate-x-1/2 z-40 p-2 text-[#1e1e1e] active:scale-95 focus:outline-none cursor-pointer"
            aria-label="Avançar imagem para o próximo destaque"
          >
            <!-- Ícone chevron idêntico ao chevron-right do HeroSlider (38px, stroke-width 2) sem transformações no hover -->
            <svg
              class="w-[38px] h-[38px] text-[#1e1e1e] filter drop-shadow-[0_2px_6px_rgba(255,255,255,0.9)]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- COLUNA 3 (DIREITA): DUAS IMAGENS VERTICAIS SEGUINTES (CONFORME IMAGENS 1 E 2) -->
      <div class="flex-1 flex items-center gap-6 sm:gap-8 overflow-hidden pr-6">
        
        <!-- Imagem 2 (Vertical Retrato, ~320px altura no desktop, com Tag no topo esquerdo) -->
        <div
          id="strip-card-1"
          class="relative flex-shrink-0 w-44 sm:w-52 md:w-56 lg:w-60 h-64 sm:h-72 md:h-80 rounded-2xl sm:rounded-3xl overflow-hidden shadow-md transition-all duration-300 cursor-pointer hover:opacity-95 bg-[#f3f4f6]"
        >
          <img
            src={slides[1].src}
            alt={slides[1].alt}
            class="w-full h-full object-cover select-none pointer-events-none"
            loading="lazy"
          />
          <!-- Tag no Canto Superior Esquerdo -->
          <div class="absolute top-3 left-3 sm:top-4 sm:left-4 z-20 pointer-events-none">
            <span
              id="tag-strip-1"
              class="font-sans text-[10px] sm:text-xs uppercase font-bold tracking-wider text-[#ffffff] drop-shadow-[0_2px_3px_rgba(0,0,0,0.85)]"
            >
              {slides[1].tag}
            </span>
          </div>
          <div class="absolute inset-x-0 top-0 h-14 bg-gradient-to-b from-black/40 to-transparent pointer-events-none"></div>
        </div>

        <!-- Imagem 3 (Quadrada/Média, ~200px altura no desktop, com Tag no topo esquerdo) -->
        <div
          id="strip-card-2"
          class="relative flex-shrink-0 w-36 sm:w-44 md:w-48 lg:w-52 h-40 sm:h-48 md:h-52 rounded-2xl sm:rounded-3xl overflow-hidden shadow-md transition-all duration-300 cursor-pointer hover:opacity-95 bg-[#f3f4f6]"
        >
          <img
            src={slides[2].src}
            alt={slides[2].alt}
            class="w-full h-full object-cover select-none pointer-events-none"
            loading="lazy"
          />
          <!-- Tag no Canto Superior Esquerdo -->
          <div class="absolute top-3 left-3 sm:top-4 sm:left-4 z-20 pointer-events-none">
            <span
              id="tag-strip-2"
              class="font-sans text-[10px] sm:text-xs uppercase font-bold tracking-wider text-[#ffffff] drop-shadow-[0_2px_3px_rgba(0,0,0,0.85)]"
            >
              {slides[2].tag}
            </span>
          </div>
          <div class="absolute inset-x-0 top-0 h-14 bg-gradient-to-b from-black/40 to-transparent pointer-events-none"></div>
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  function initAboutSectionFinal() {
    const section = document.getElementById('sobre-nos-lactimonte');
    if (!section) return;

    const nextBtn = document.getElementById('about-slider-next-btn');
    const featuredCard = document.getElementById('featured-image-card');
    const featuredImg = document.getElementById('featured-main-img') as HTMLImageElement | null;
    const featuredTag = document.getElementById('featured-main-tag');

    const card1 = document.getElementById('strip-card-1') as HTMLElement | null;
    const card2 = document.getElementById('strip-card-2') as HTMLElement | null;
    const tag1 = document.getElementById('tag-strip-1');
    const tag2 = document.getElementById('tag-strip-2');

    if (!nextBtn || !featuredImg || !featuredTag || !card1 || !card2) return;

    const slidesData = [
      {
        src: '/assets/imagem/carrosel_imagem/lactimonte-tradicao-fabrico.jpg',
        alt: 'Mestria queijeira tradicional na produção de queijo',
        tag: 'Arte Queijeira',
      },
      {
        src: '/assets/imagem/carrosel_imagem/lactimonte-cave-maturacao.jpg',
        alt: 'Cave de cura e maturação de queijos tradicionais',
        tag: 'Cura & Maturação',
      },
      {
        src: '/assets/imagem/carrosel_imagem/lactimonte-pastagens-mafra.jpg',
        alt: 'Pastagens verdes e rebanhos da Região Saloia em Mafra',
        tag: 'Terroir Saloio',
      },
      {
        src: '/assets/imagem/carrosel_imagem/lactimonte-mesa-degustacao.jpg',
        alt: 'Mesa de degustação com queijo curado, pão de Mafra e mel',
        tag: 'Mesa Portuguesa',
      },
      {
        src: '/assets/imagem/carrosel_imagem/lactimonte-rebanhos-campo.jpg',
        alt: 'Rebanhos pastando livremente nos campos de Mafra',
        tag: 'Pastoreio Livre',
      },
    ];

    const total = slidesData.length;
    let activeIndex = 0;
    let isTransitioning = false;

    function updateStrip() {
      const idx1 = (activeIndex + 1) % total;
      const idx2 = (activeIndex + 2) % total;

      const img1 = card1 ? card1.querySelector('img') : null;
      const img2 = card2 ? card2.querySelector('img') : null;

      if (img1) {
        img1.src = slidesData[idx1].src;
        img1.alt = slidesData[idx1].alt;
      }
      if (tag1) tag1.textContent = slidesData[idx1].tag;

      if (img2) {
        img2.src = slidesData[idx2].src;
        img2.alt = slidesData[idx2].alt;
      }
      if (tag2) tag2.textContent = slidesData[idx2].tag;
    }

    function advanceSlide() {
      if (isTransitioning) return;
      isTransitioning = true;

      const nextIndex = (activeIndex + 1) % total;
      const nextItem = slidesData[nextIndex];

      // Efeito de piscar na foto principal (flash suave)
      if (featuredCard) {
        featuredCard.style.transition = 'opacity 120ms ease-in';
        featuredCard.style.opacity = '0.3';
      }

      setTimeout(() => {
        // Atualiza a imagem principal para a nova que assume a posição 1
        featuredImg.src = nextItem.src;
        featuredImg.alt = nextItem.alt;
        featuredTag.textContent = nextItem.tag;

        activeIndex = nextIndex;
        updateStrip();

        // Conclui o piscar recuperando a opacidade total
        if (featuredCard) {
          featuredCard.style.transition = 'opacity 250ms ease-out';
          featuredCard.style.opacity = '1';
        }

        setTimeout(() => {
          isTransitioning = false;
        }, 200);
      }, 130);
    }

    nextBtn.addEventListener('click', (e) => {
      e.preventDefault();
      advanceSlide();
    });

    [card1, card2].forEach((card) => {
      if (!card) return;
      card.addEventListener('click', () => {
        advanceSlide();
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAboutSectionFinal);
  } else {
    initAboutSectionFinal();
  }
  document.addEventListener('astro:page-load', initAboutSectionFinal);
</script>
